#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "%s:"
msgstr "%s:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Address is a gateway (skip the portal)"
msgstr "Adresa este un gateway (omite portalul)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Address of the GlobalProtect portal (e.g. vpn.company.com).\n"
"If your organisation gave you a gateway address instead, also tick \"Address "
"is a gateway\" below."
msgstr ""
"Adresa portalului GlobalProtect (de exemplu, vpn.company.com).\n"
"Dacă organizația dumneavoastră v-a dat în schimb o adresă de gateway, bifați și „Adresa este un gateway” de mai jos."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Always on"
msgstr "Întotdeauna activat"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authenticate VPN: %s"
msgstr "Autentificare VPN: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authentication failed. Enter the credentials for “%s” again."
msgstr "Autentificarea a eșuat. Introduceți din nou datele de autentificare pentru „%s”."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Authentication:"
msgstr "Autentificare:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Automatic (enable when the portal needs it)"
msgstr "Automat (se activează când portalul are nevoie)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser (SAML, passkey, 2FA)"
msgstr "Browser (SAML, passkey, 2FA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser used for SAML/2FA authentication. \"edge\" is the best tested "
"option; \"default\" uses your desktop's default browser.\n"
"Select 'Custom...' to give the full path to your own executable."
msgstr ""
"Browserul folosit pentru autentificarea SAML/2FA. „edge” este opțiunea cea mai bine testată; „default” folosește browserul implicit al desktopului dumneavoastră.\n"
"Selectați „Personalizat...” pentru a indica calea completă către propriul executabil."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser:"
msgstr "Browser:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser: the portal opens a browser window for single sign-on (default).\n"
"Username and password: the portal asks on the terminal - the credentials and "
"any token are requested in a dialog instead."
msgstr ""
"Browser: portalul deschide o fereastră de browser pentru autentificare unică (implicit).\n"
"Nume de utilizator și parolă: portalul întreabă în terminal - în schimb, datele de autentificare și orice token sunt cerute într-o fereastră de dialog."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Connect timeout:"
msgstr "Timp de expirare a conexiunii:"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Credentials are required to connect to “%s”."
msgstr "Sunt necesare date de autentificare pentru a vă conecta la „%s”."

#: plugins/gnome/nm-gpclient-editor-common.h plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Custom..."
msgstr "Personalizat..."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "DNS Servers:"
msgstr "Servere DNS:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: built-in HIP report"
msgstr "Gol: raport HIP încorporat"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable HIP (Host Integrity Protection) to send host information to the VPN "
"gateway.\n"
"This is required by some organizations for security compliance."
msgstr ""
"Activați HIP (Host Integrity Protection) pentru a trimite informații despre gazdă către gatewayul VPN.\n"
"Acest lucru este cerut de unele organizații pentru conformitatea cu normele de securitate."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Enable Host Integrity Protection (HIP)"
msgstr "Activează Host Integrity Protection (HIP)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable when the address above is a gateway rather than a portal.\n"
"Without this the portal workflow is tried first, which can make you "
"authenticate twice."
msgstr ""
"Activați când adresa de mai sus este un gateway, nu un portal.\n"
"Fără aceasta, se încearcă mai întâi fluxul portalului, ceea ce vă poate obliga să vă autentificați de două ori."

#: plugins/gnome/nm-gpclient-editor-common.h
msgid "First proposed by portal (automatic)"
msgstr "Prima propusă de portal (automat)"

#: plugins/gnome/nm-gpclient-editor-plugin.c
#: plugins/gnome/nm-gpclient-plugin-simple.c
msgid "GlobalProtect VPN Client"
msgstr "Client VPN GlobalProtect"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP script:"
msgstr "Script HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP:"
msgstr "HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"How long NetworkManager waits for the VPN to connect, including the login in "
"the browser (vpn.timeout).\n"
"0 uses the NetworkManager default, usually 60 s - often too short for a SAML "
"login with MFA. A new connection with browser authentication starts with 360 "
"s. While a connection has no timeout of its own (0) and you have not changed "
"this field, choosing browser authentication sets 360 s."
msgstr ""
"Cât timp așteaptă NetworkManager conectarea VPN, inclusiv autentificarea în browser (vpn.timeout).\n"
"0 folosește valoarea implicită din NetworkManager, de obicei 60 s - adesea prea scurtă pentru o autentificare SAML cu MFA. O conexiune nouă cu autentificare prin browser pornește cu 360 s. Cât timp o conexiune nu are un timp de expirare propriu (0) și nu ați modificat acest câmp, alegerea autentificării prin browser setează 360 s."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Legacy TLS renegotiation:"
msgstr "Renegociere TLS veche:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "MTU:"
msgstr "MTU:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Maximum size of a packet in the tunnel.\n"
"0 = Automatic. Lowering it (for example to 1300-1400) may help when the "
"tunnel falls back from ESP to HTTPS with \"Message too long\".\n"
"It has an effect only when the gateway sends no MTU of its own. Values from "
"1 to 575 are saved as 576, the lowest value that is used."
msgstr ""
"Dimensiunea maximă a unui pachet în tunel.\n"
"0 = automat. Reducerea ei (de exemplu, la 1300-1400) poate ajuta când tunelul revine de la ESP la HTTPS cu „Message too long”.\n"
"Are efect numai când gatewayul nu trimite un MTU propriu. Valorile de la 1 la 575 se salvează ca 576, cea mai mică valoare folosită."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Never"
msgstr "Niciodată"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to a custom HIP executable, passed to gpclient as --"
"hip=<path>.\n"
"The service runs it as root: it must be a root-owned file that is not "
"writable by group or others, in root-owned directories that are not writable "
"by group or others. Otherwise the connection fails.\n"
"Ignored when HIP is off."
msgstr ""
"Cale absolută opțională către un executabil HIP personalizat, transmisă lui gpclient ca --hip=<path>.\n"
"Serviciul îl rulează ca root: trebuie să fie un fișier deținut de root, în care nu pot scrie grupul sau alții, în directoare deținute de root, în care nu pot scrie grupul sau alții. În caz contrar, conexiunea eșuează.\n"
"Ignorat când HIP este dezactivat."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional. Use the icon in the field to choose where the password is kept: "
"for this user only, for all users, or not at all (asked every time)."
msgstr "Opțional. Folosiți pictograma din câmp pentru a alege unde se păstrează parola: numai pentru acest utilizator, pentru toți utilizatorii sau deloc (se cere de fiecare dată)."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional. Used by portals that ask for credentials on the terminal, so you "
"are not asked for the username every time."
msgstr "Opțional. Folosit de portalurile care cer datele de autentificare în terminal, ca să nu vi se ceară numele de utilizator de fiecare dată."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Password"
msgstr "Parolă"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Password:"
msgstr "Parolă:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Portal or gateway address:"
msgstr "Adresa portalului sau a gatewayului:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Portals with an old TLS stack need renegotiation that OpenSSL 3 refuses by "
"default.\n"
"Automatic: retry once with the workaround when the portal asks for it, and "
"switch this setting to \"Always on\" afterwards, so the failed first attempt "
"does not repeat."
msgstr ""
"Portalurile cu o stivă TLS veche au nevoie de renegociere, pe care OpenSSL 3 o refuză implicit.\n"
"Automat: se reîncearcă o dată cu soluția de ocolire când portalul o cere, apoi această setare se schimbă în „Întotdeauna activat”, ca prima încercare eșuată să nu se repete."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Preferred gateway:"
msgstr "Gateway preferat:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Recommended: Leave empty to use DNS servers from VPN with automatic split "
"DNS configuration.\n"
"Split DNS allows resolving VPN-specific domains through VPN DNS while using "
"local DNS for other domains.\n"
"Override: Enter semicolon-separated DNS servers (e.g., 8.8.8.8;8.8.4.4) to "
"use custom DNS instead."
msgstr ""
"Recomandat: lăsați gol pentru a folosi serverele DNS din VPN cu configurare automată de DNS divizat.\n"
"DNS-ul divizat permite rezolvarea domeniilor specifice VPN prin DNS-ul VPN, folosind DNS-ul local pentru celelalte domenii.\n"
"Suprascriere: introduceți servere DNS separate prin punct și virgulă (de exemplu, 8.8.8.8;8.8.4.4) pentru a folosi în schimb un DNS personalizat."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Token / one-time code"
msgstr "Token / cod de unică folosință"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "User: %s"
msgstr "Utilizator: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Username"
msgstr "Nume de utilizator"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username and password (RSA token)"
msgstr "Nume de utilizator și parolă (token RSA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username:"
msgstr "Nume de utilizator:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Which gateway to connect to. The list is filled in after the first "
"successful connection.\n"
"If the chosen gateway is not offered by the portal any more, the first "
"proposal is used instead."
msgstr ""
"La ce gateway să se conecteze. Lista se completează după prima conectare reușită.\n"
"Dacă gatewayul ales nu mai este oferit de portal, se folosește în schimb prima propunere."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_Cancel"
msgstr "_Anulează"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_OK"
msgstr "_OK"

#: plugins/gnome/nm-gpclient-validate.h
msgid ""
"browser must be a name, a command name or an absolute path without spaces"
msgstr "browserul trebuie să fie un nume, un nume de comandă sau o cale absolută fără spații"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "bytes (0 = Automatic)"
msgstr "octeți (0 = automat)"

#: plugins/gnome/nm-gpclient-validate.h
msgid ""
"dns must be IPv4 or IPv6 addresses separated by commas, semicolons or spaces"
msgstr "dns trebuie să fie adrese IPv4 sau IPv6 separate prin virgule, punct și virgulă sau spații"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway is required"
msgstr "gatewayul este obligatoriu"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway must not start with '-' or contain spaces or control characters"
msgstr "gatewayul nu trebuie să înceapă cu „-” și nu trebuie să conțină spații sau caractere de control"

#: plugins/gnome/nm-gpclient-validate.h
msgid "hip-script must be an absolute path"
msgstr "hip-script trebuie să fie o cale absolută"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "seconds (0 = NetworkManager default)"
msgstr "secunde (0 = valoarea implicită din NetworkManager)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "username must not start with '-' or contain control characters"
msgstr "numele de utilizator nu trebuie să înceapă cu „-” și nu trebuie să conțină caractere de control"

#: plugins/gnome/nm-gpclient-keyfile.h
msgid "The file is not a GlobalProtect VPN connection"
msgstr "Fișierul nu este o conexiune VPN GlobalProtect"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "SAML login:"
msgstr "Autentificare SAML:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the service (default)"
msgstr "În serviciu (implicit)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the login dialog"
msgstr "În dialogul de autentificare"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Where the browser login runs: in the service, or in the login dialog (in your session)."
msgstr "Unde rulează autentificarea prin browser: în serviciu sau în dialogul de autentificare (în sesiunea dvs.)."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Certificate passphrase"
msgstr "Fraza secretă a certificatului"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Certificate passphrase:"
msgstr "Fraza secretă a certificatului:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Client certificate:"
msgstr "Certificat client:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: no client certificate"
msgstr "Gol: fără certificat client"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: the key is in the certificate file"
msgstr "Gol: cheia este în fișierul certificatului"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the client certificate file (PEM or PKCS#12), "
"owned by your desktop user."
msgstr "Calea absolută opțională a fișierului certificatului client (PEM sau PKCS#12), care trebuie să aparțină utilizatorului desktopului."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the private key file (PEM), owned by your "
"desktop user. Ignored without a client certificate."
msgstr "Calea absolută opțională a fișierului cheii private (PEM), care trebuie să aparțină utilizatorului desktopului. Ignorată fără certificat client."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Private key:"
msgstr "Cheie privată:"

#: plugins/gnome/nm-gpclient-validate.h
msgid "usercert must be an absolute path"
msgstr "usercert trebuie să fie o cale absolută"

#: plugins/gnome/nm-gpclient-validate.h
msgid "userkey must be an absolute path"
msgstr "userkey trebuie să fie o cale absolută"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose a file"
msgstr "Alegeți un fișier"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the client certificate"
msgstr "Alegeți certificatul de client"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the private key"
msgstr "Alegeți cheia privată"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the HIP script"
msgstr "Alegeți scriptul HIP"
