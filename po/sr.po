#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "%s:"
msgstr "%s:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Address is a gateway (skip the portal)"
msgstr "Адреса је мрежни пролаз (прескочи портал)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Address of the GlobalProtect portal (e.g. vpn.company.com).\n"
"If your organisation gave you a gateway address instead, also tick \"Address is a gateway\" below."
msgstr ""
"Адреса GlobalProtect портала (нпр. vpn.company.com).\n"
"Ако вам је организација дала адресу мрежног пролаза, означите доле и „Адреса је мрежни пролаз“."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Always on"
msgstr "Увек укључено"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authenticate VPN: %s"
msgstr "Потврда идентитета за VPN: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authentication failed. Enter the credentials for “%s” again."
msgstr "Потврда идентитета није успела. Поново унесите акредитиве за „%s“."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Authentication:"
msgstr "Потврда идентитета:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Automatic (enable when the portal needs it)"
msgstr "Аутоматски (укључи када портал то захтева)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser (SAML, passkey, 2FA)"
msgstr "Прегледач (SAML, passkey, 2FA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser used for SAML/2FA authentication. \"edge\" is the best tested option; \"default\" uses your desktop's default browser.\n"
"Select 'Custom...' to give the full path to your own executable."
msgstr ""
"Прегледач који се користи за SAML/2FA потврду идентитета. „edge“ је најбоље испробана опција; „default“ користи подразумевани прегледач вашег радног окружења.\n"
"Изаберите „Прилагођено...“ да унесете пуну путању до сопствене извршне датотеке."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser:"
msgstr "Прегледач:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser: the portal opens a browser window for single sign-on (default).\n"
"Username and password: the portal asks on the terminal - the credentials and any token are requested in a dialog instead."
msgstr ""
"Прегледач: портал отвара прозор прегледача за једнократну пријаву (подразумевано).\n"
"Корисничко име и лозинка: портал пита у терминалу - акредитиви и евентуални жетон се уместо тога траже у дијалогу."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Connect timeout:"
msgstr "Време истека повезивања:"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Credentials are required to connect to “%s”."
msgstr "За повезивање са „%s“ потребни су акредитиви."

#: plugins/gnome/nm-gpclient-editor-common.h plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Custom..."
msgstr "Прилагођено..."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "DNS Servers:"
msgstr "DNS сервери:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: built-in HIP report"
msgstr "Празно: уграђени HIP извештај"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable HIP (Host Integrity Protection) to send host information to the VPN gateway.\n"
"This is required by some organizations for security compliance."
msgstr ""
"Укључите HIP (Host Integrity Protection) да се подаци о домаћину шаљу VPN мрежном пролазу.\n"
"Неке организације то захтевају ради усклађености са безбедносним правилима."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Enable Host Integrity Protection (HIP)"
msgstr "Укључи Host Integrity Protection (HIP)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable when the address above is a gateway rather than a portal.\n"
"Without this the portal workflow is tried first, which can make you authenticate twice."
msgstr ""
"Укључите када је адреса изнад мрежни пролаз, а не портал.\n"
"Без овога се прво покушава радни ток преко портала, што може довести до двоструке потврде идентитета."

#: plugins/gnome/nm-gpclient-editor-common.h
msgid "First proposed by portal (automatic)"
msgstr "Први који предложи портал (аутоматски)"

#: plugins/gnome/nm-gpclient-editor-plugin.c
#: plugins/gnome/nm-gpclient-plugin-simple.c
msgid "GlobalProtect VPN Client"
msgstr "GlobalProtect VPN клијент"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP script:"
msgstr "HIP скрипта:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP:"
msgstr "HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"How long NetworkManager waits for the VPN to connect, including the login in the browser (vpn.timeout).\n"
"0 uses the NetworkManager default, usually 60 s - often too short for a SAML login with MFA. A new connection with browser authentication starts with 360 s. While a connection has no timeout of its own (0) and you have not changed this field, choosing browser authentication sets 360 s."
msgstr ""
"Колико дуго NetworkManager чека да се VPN повеже, укључујући пријаву у прегледачу (vpn.timeout).\n"
"0 користи подразумевану вредност NetworkManager-а, обично 60 s - често прекратко за SAML пријаву са MFA. Нова веза са потврдом идентитета у прегледачу почиње са 360 s. Док веза нема сопствено време истека (0) а ово поље нисте мењали, избор потврде идентитета у прегледачу поставља 360 s."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Legacy TLS renegotiation:"
msgstr "Старо поновно преговарање TLS-а:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "MTU:"
msgstr "MTU:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Maximum size of a packet in the tunnel.\n"
"0 = Automatic. Lowering it (for example to 1300-1400) may help when the tunnel falls back from ESP to HTTPS with \"Message too long\".\n"
"It has an effect only when the gateway sends no MTU of its own. Values from 1 to 575 are saved as 576, the lowest value that is used."
msgstr ""
"Највећа величина пакета у тунелу.\n"
"0 = аутоматски. Смањивање (на пример на 1300-1400) може помоћи када тунел пређе са ESP на HTTPS уз грешку „Message too long“.\n"
"Има ефекта само када мрежни пролаз не шаље сопствени MTU. Вредности од 1 до 575 чувају се као 576, најнижа вредност која се користи."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Never"
msgstr "Никада"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to a custom HIP executable, passed to gpclient as --hip=<path>.\n"
"The service runs it as root: it must be a root-owned file that is not writable by group or others, in root-owned directories that are not writable by group or others. Otherwise the connection fails.\n"
"Ignored when HIP is off."
msgstr ""
"Необавезна апсолутна путања до сопствене HIP извршне датотеке, која се прослеђује gpclient-у као --hip=<path>.\n"
"Услуга је покреће као root: мора бити датотека у власништву root-а, у коју група и остали не могу писати, у директоријумима у власништву root-а, у које група и остали не могу писати. У супротном повезивање не успева.\n"
"Игнорише се када је HIP искључен."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Use the icon in the field to choose where the password is kept: for this user only, for all users, or not at all (asked every time)."
msgstr "Необавезно. Помоћу иконице у пољу изаберите где се чува лозинка: само за овог корисника, за све кориснике или нигде (пита се сваки пут)."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Used by portals that ask for credentials on the terminal, so you are not asked for the username every time."
msgstr "Необавезно. Користе га портали који траже акредитиве у терминалу, да вас не питају за корисничко име сваки пут."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Password"
msgstr "Лозинка"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Password:"
msgstr "Лозинка:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Portal or gateway address:"
msgstr "Адреса портала или мрежног пролаза:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Portals with an old TLS stack need renegotiation that OpenSSL 3 refuses by default.\n"
"Automatic: retry once with the workaround when the portal asks for it, and switch this setting to \"Always on\" afterwards, so the failed first attempt does not repeat."
msgstr ""
"Портали са старим TLS стеком захтевају поновно преговарање које OpenSSL 3 подразумевано одбија.\n"
"Аутоматски: једном покушај поново са заобилазним решењем када портал то захтева, а затим пребаци ово подешавање на „Увек укључено“, да се неуспели први покушај не понавља."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Preferred gateway:"
msgstr "Жељени мрежни пролаз:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Recommended: Leave empty to use DNS servers from VPN with automatic split DNS configuration.\n"
"Split DNS allows resolving VPN-specific domains through VPN DNS while using local DNS for other domains.\n"
"Override: Enter semicolon-separated DNS servers (e.g., 8.8.8.8;8.8.4.4) to use custom DNS instead."
msgstr ""
"Препоручено: оставите празно да се користе DNS сервери из VPN-а са аутоматском split DNS подешавањем.\n"
"Split DNS омогућава разрешавање домена специфичних за VPN преко VPN DNS-а, док се за остале домене користи локални DNS.\n"
"Преписивање: унесите DNS сервере раздвојене тачком и зарезом (нпр. 8.8.8.8;8.8.4.4) да се уместо тога користи сопствени DNS."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Token / one-time code"
msgstr "Жетон / једнократни кôд"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "User: %s"
msgstr "Корисник: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Username"
msgstr "Корисничко име"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username and password (RSA token)"
msgstr "Корисничко име и лозинка (RSA жетон)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username:"
msgstr "Корисничко име:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Which gateway to connect to. The list is filled in after the first successful connection.\n"
"If the chosen gateway is not offered by the portal any more, the first proposal is used instead."
msgstr ""
"Са којим мрежним пролазом се повезати. Списак се попуњава након првог успешног повезивања.\n"
"Ако изабрани мрежни пролаз портал више не нуди, уместо њега се користи први предлог."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_Cancel"
msgstr "_Откажи"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_OK"
msgstr "_У реду"

#: plugins/gnome/nm-gpclient-validate.h
msgid "browser must be a name, a command name or an absolute path without spaces"
msgstr "прегледач мора бити име, име наредбе или апсолутна путања без размака"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "bytes (0 = Automatic)"
msgstr "бајтова (0 = аутоматски)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "dns must be IPv4 or IPv6 addresses separated by commas, semicolons or spaces"
msgstr "dns мора бити IPv4 или IPv6 адресе раздвојене зарезима, тачкама и зарезима или размацима"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway is required"
msgstr "мрежни пролаз је обавезан"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway must not start with '-' or contain spaces or control characters"
msgstr "мрежни пролаз не сме почињати са „-“ нити садржати размаке или контролне знакове"

#: plugins/gnome/nm-gpclient-validate.h
msgid "hip-script must be an absolute path"
msgstr "hip-script мора бити апсолутна путања"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "seconds (0 = NetworkManager default)"
msgstr "секунди (0 = подразумевано за NetworkManager)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "username must not start with '-' or contain control characters"
msgstr "корисничко име не сме почињати са „-“ нити садржати контролне знакове"

#: plugins/gnome/nm-gpclient-keyfile.h
msgid "The file is not a GlobalProtect VPN connection"
msgstr "Датотека није GlobalProtect VPN веза"
