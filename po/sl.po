#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "%s:"
msgstr "%s:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Address is a gateway (skip the portal)"
msgstr "Naslov je prehod (preskoči portal)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Address of the GlobalProtect portal (e.g. vpn.company.com).\n"
"If your organisation gave you a gateway address instead, also tick \"Address is a gateway\" below."
msgstr ""
"Naslov portala GlobalProtect (npr. vpn.company.com).\n"
"Če vam je organizacija dala naslov prehoda, spodaj označite tudi »Naslov je prehod«."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Always on"
msgstr "Vedno vklopljeno"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authenticate VPN: %s"
msgstr "Overitev VPN: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authentication failed. Enter the credentials for “%s” again."
msgstr "Overitev ni uspela. Znova vnesite poverilnice za »%s«."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Authentication:"
msgstr "Overitev:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Automatic (enable when the portal needs it)"
msgstr "Samodejno (vklopi, ko portal to zahteva)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser (SAML, passkey, 2FA)"
msgstr "Brskalnik (SAML, ključ za dostop, 2FA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser used for SAML/2FA authentication. \"edge\" is the best tested option; \"default\" uses your desktop's default browser.\n"
"Select 'Custom...' to give the full path to your own executable."
msgstr ""
"Brskalnik za overitev SAML/2FA. »edge« je najbolje preizkušena možnost; »default« uporabi privzeti brskalnik namizja.\n"
"Izberite »Po meri...«, da vnesete polno pot do lastne izvedljive datoteke."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser:"
msgstr "Brskalnik:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser: the portal opens a browser window for single sign-on (default).\n"
"Username and password: the portal asks on the terminal - the credentials and any token are requested in a dialog instead."
msgstr ""
"Brskalnik: portal odpre okno brskalnika za enotno prijavo (privzeto).\n"
"Uporabniško ime in geslo: portal vpraša v terminalu - poverilnice in morebitni žeton se namesto tega zahtevajo v pogovornem oknu."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Connect timeout:"
msgstr "Časovna omejitev povezave:"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Credentials are required to connect to “%s”."
msgstr "Za povezavo z »%s« so potrebne poverilnice."

#: plugins/gnome/nm-gpclient-editor-common.h plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Custom..."
msgstr "Po meri..."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "DNS Servers:"
msgstr "Strežniki DNS:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: built-in HIP report"
msgstr "Prazno: vgrajeno poročilo HIP"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable HIP (Host Integrity Protection) to send host information to the VPN gateway.\n"
"This is required by some organizations for security compliance."
msgstr ""
"Vklopite HIP (Host Integrity Protection), da se podatki o gostitelju pošljejo prehodu VPN.\n"
"Nekatere organizacije to zahtevajo zaradi skladnosti z varnostnimi pravili."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Enable Host Integrity Protection (HIP)"
msgstr "Vklopi Host Integrity Protection (HIP)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable when the address above is a gateway rather than a portal.\n"
"Without this the portal workflow is tried first, which can make you authenticate twice."
msgstr ""
"Vklopite, če je zgornji naslov prehod in ne portal.\n"
"Brez tega se najprej poskusi postopek prek portala, zaradi česar se boste morda morali overiti dvakrat."

#: plugins/gnome/nm-gpclient-editor-common.h
msgid "First proposed by portal (automatic)"
msgstr "Prvi, ki ga predlaga portal (samodejno)"

#: plugins/gnome/nm-gpclient-editor-plugin.c
#: plugins/gnome/nm-gpclient-plugin-simple.c
msgid "GlobalProtect VPN Client"
msgstr "Odjemalec GlobalProtect VPN"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP script:"
msgstr "Skript HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP:"
msgstr "HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"How long NetworkManager waits for the VPN to connect, including the login in the browser (vpn.timeout).\n"
"0 uses the NetworkManager default, usually 60 s - often too short for a SAML login with MFA. A new connection with browser authentication starts with 360 s. While a connection has no timeout of its own (0) and you have not changed this field, choosing browser authentication sets 360 s."
msgstr ""
"Kako dolgo NetworkManager čaka na povezavo VPN, vključno s prijavo v brskalniku (vpn.timeout).\n"
"0 uporabi privzeto vrednost NetworkManagerja, običajno 60 s - za prijavo SAML z MFA pogosto prekratko. Nova povezava z overitvijo v brskalniku se začne s 360 s. Dokler povezava nima lastne časovne omejitve (0) in tega polja niste spremenili, izbira overitve v brskalniku nastavi 360 s."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Legacy TLS renegotiation:"
msgstr "Starejše ponovno pogajanje TLS:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "MTU:"
msgstr "MTU:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Maximum size of a packet in the tunnel.\n"
"0 = Automatic. Lowering it (for example to 1300-1400) may help when the tunnel falls back from ESP to HTTPS with \"Message too long\".\n"
"It has an effect only when the gateway sends no MTU of its own. Values from 1 to 575 are saved as 576, the lowest value that is used."
msgstr ""
"Največja velikost paketa v tunelu.\n"
"0 = samodejno. Znižanje (na primer na 1300-1400) lahko pomaga, ko tunel preide z ESP na HTTPS z napako »Message too long«.\n"
"Učinkuje le, če prehod ne pošlje lastnega MTU. Vrednosti od 1 do 575 se shranijo kot 576, najnižja uporabljena vrednost."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Never"
msgstr "Nikoli"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to a custom HIP executable, passed to gpclient as --hip=<path>.\n"
"The service runs it as root: it must be a root-owned file that is not writable by group or others, in root-owned directories that are not writable by group or others. Otherwise the connection fails.\n"
"Ignored when HIP is off."
msgstr ""
"Neobvezna absolutna pot do lastne izvedljive datoteke HIP, ki se gpclient posreduje kot --hip=<path>.\n"
"Storitev jo zažene kot root: biti mora datoteka v lasti uporabnika root, v katero skupina in drugi ne smejo pisati, v imenikih v lasti uporabnika root, v katere skupina in drugi ne smejo pisati. Sicer povezava ne uspe.\n"
"Prezrto, ko je HIP izklopljen."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Use the icon in the field to choose where the password is kept: for this user only, for all users, or not at all (asked every time)."
msgstr "Neobvezno. Z ikono v polju izberite, kje se geslo hrani: samo za tega uporabnika, za vse uporabnike ali sploh ne (vprašanje vsakič)."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Used by portals that ask for credentials on the terminal, so you are not asked for the username every time."
msgstr "Neobvezno. Uporabljajo portali, ki poverilnice zahtevajo v terminalu, da vas ni treba vsakič vprašati za uporabniško ime."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Password"
msgstr "Geslo"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Password:"
msgstr "Geslo:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Portal or gateway address:"
msgstr "Naslov portala ali prehoda:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Portals with an old TLS stack need renegotiation that OpenSSL 3 refuses by default.\n"
"Automatic: retry once with the workaround when the portal asks for it, and switch this setting to \"Always on\" afterwards, so the failed first attempt does not repeat."
msgstr ""
"Portali s starim skladom TLS potrebujejo ponovno pogajanje, ki ga OpenSSL 3 privzeto zavrne.\n"
"Samodejno: ko portal to zahteva, se enkrat poskusi z obvodom, nato se ta nastavitev preklopi na »Vedno vklopljeno«, da se neuspel prvi poskus ne ponovi."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Preferred gateway:"
msgstr "Prednostni prehod:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Recommended: Leave empty to use DNS servers from VPN with automatic split DNS configuration.\n"
"Split DNS allows resolving VPN-specific domains through VPN DNS while using local DNS for other domains.\n"
"Override: Enter semicolon-separated DNS servers (e.g., 8.8.8.8;8.8.4.4) to use custom DNS instead."
msgstr ""
"Priporočeno: pustite prazno, da se uporabijo strežniki DNS iz VPN s samodejno konfiguracijo split DNS.\n"
"Split DNS omogoča razreševanje domen VPN prek DNS VPN, za druge domene pa se uporablja lokalni DNS.\n"
"Prepis: vnesite strežnike DNS, ločene s podpičjem (npr. 8.8.8.8;8.8.4.4), da se namesto tega uporabi lasten DNS."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Token / one-time code"
msgstr "Žeton / enkratna koda"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "User: %s"
msgstr "Uporabnik: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Username"
msgstr "Uporabniško ime"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username and password (RSA token)"
msgstr "Uporabniško ime in geslo (žeton RSA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username:"
msgstr "Uporabniško ime:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Which gateway to connect to. The list is filled in after the first successful connection.\n"
"If the chosen gateway is not offered by the portal any more, the first proposal is used instead."
msgstr ""
"S katerim prehodom se povezati. Seznam se zapolni po prvi uspešni povezavi.\n"
"Če portal izbranega prehoda ne ponuja več, se uporabi prvi predlog."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_Cancel"
msgstr "_Prekliči"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_OK"
msgstr "_V redu"

#: plugins/gnome/nm-gpclient-validate.h
msgid "browser must be a name, a command name or an absolute path without spaces"
msgstr "brskalnik mora biti ime, ime ukaza ali absolutna pot brez presledkov"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "bytes (0 = Automatic)"
msgstr "bajtov (0 = samodejno)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "dns must be IPv4 or IPv6 addresses separated by commas, semicolons or spaces"
msgstr "dns mora biti naslovi IPv4 ali IPv6, ločeni z vejicami, podpičji ali presledki"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway is required"
msgstr "prehod je obvezen"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway must not start with '-' or contain spaces or control characters"
msgstr "prehod se ne sme začeti z »-« ali vsebovati presledkov ali kontrolnih znakov"

#: plugins/gnome/nm-gpclient-validate.h
msgid "hip-script must be an absolute path"
msgstr "hip-script mora biti absolutna pot"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "seconds (0 = NetworkManager default)"
msgstr "sekund (0 = privzeto za NetworkManager)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "username must not start with '-' or contain control characters"
msgstr "uporabniško ime se ne sme začeti z »-« ali vsebovati kontrolnih znakov"

#: plugins/gnome/nm-gpclient-keyfile.h
msgid "The file is not a GlobalProtect VPN connection"
msgstr "Datoteka ni povezava GlobalProtect VPN"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "SAML login:"
msgstr "Prijava SAML:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the service (default)"
msgstr "V storitvi (privzeto)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the login dialog"
msgstr "V pogovornem oknu za prijavo"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Where the browser login runs: in the service, or in the login dialog (in your session)."
msgstr "Kje teče prijava v brskalniku: v storitvi ali v pogovornem oknu za prijavo (v vaši seji)."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Certificate passphrase"
msgstr "Geslo certifikata"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Certificate passphrase:"
msgstr "Geslo certifikata:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Client certificate:"
msgstr "Odjemalčev certifikat:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: no client certificate"
msgstr "Prazno: brez odjemalčevega certifikata"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: the key is in the certificate file"
msgstr "Prazno: ključ je v datoteki certifikata"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the client certificate file (PEM or PKCS#12), "
"owned by your desktop user."
msgstr "Neobvezna absolutna pot do datoteke odjemalčevega certifikata (PEM ali PKCS#12), katere lastnik mora biti uporabnik namizja."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the private key file (PEM), owned by your "
"desktop user. Ignored without a client certificate."
msgstr "Neobvezna absolutna pot do datoteke zasebnega ključa (PEM), katere lastnik mora biti uporabnik namizja. Brez odjemalčevega certifikata se prezre."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Private key:"
msgstr "Zasebni ključ:"

#: plugins/gnome/nm-gpclient-validate.h
msgid "usercert must be an absolute path"
msgstr "usercert mora biti absolutna pot"

#: plugins/gnome/nm-gpclient-validate.h
msgid "userkey must be an absolute path"
msgstr "userkey mora biti absolutna pot"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose a file"
msgstr "Izberi datoteko"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the client certificate"
msgstr "Izberite odjemalčevo potrdilo"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the private key"
msgstr "Izberite zasebni ključ"
