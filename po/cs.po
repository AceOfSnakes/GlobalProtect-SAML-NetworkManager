#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "%s:"
msgstr "%s:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Address is a gateway (skip the portal)"
msgstr "Adresa je brána (přeskočit portál)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Address of the GlobalProtect portal (e.g. vpn.company.com).\n"
"If your organisation gave you a gateway address instead, also tick \"Address is a gateway\" below."
msgstr ""
"Adresa portálu GlobalProtect (např. vpn.company.com).\n"
"Pokud vám organizace dala místo toho adresu brány, zaškrtněte níže také „Adresa je brána“."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Always on"
msgstr "Vždy zapnuto"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authenticate VPN: %s"
msgstr "Ověření VPN: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authentication failed. Enter the credentials for “%s” again."
msgstr "Ověření selhalo. Zadejte přihlašovací údaje pro „%s“ znovu."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Authentication:"
msgstr "Ověření:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Automatic (enable when the portal needs it)"
msgstr "Automaticky (zapnout, když to portál vyžaduje)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser (SAML, passkey, 2FA)"
msgstr "Prohlížeč (SAML, passkey, 2FA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser used for SAML/2FA authentication. \"edge\" is the best tested option; \"default\" uses your desktop's default browser.\n"
"Select 'Custom...' to give the full path to your own executable."
msgstr ""
"Prohlížeč používaný pro ověření SAML/2FA. „edge“ je nejlépe otestovaná možnost; „default“ používá výchozí prohlížeč vašeho prostředí.\n"
"Vyberte „Vlastní...“ a zadejte úplnou cestu ke svému vlastnímu spustitelnému souboru."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser:"
msgstr "Prohlížeč:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser: the portal opens a browser window for single sign-on (default).\n"
"Username and password: the portal asks on the terminal - the credentials and any token are requested in a dialog instead."
msgstr ""
"Prohlížeč: portál otevře okno prohlížeče pro jednotné přihlášení (výchozí).\n"
"Uživatelské jméno a heslo: portál se ptá v terminálu – přihlašovací údaje a případný token se místo toho vyžádají v dialogu."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Connect timeout:"
msgstr "Časový limit připojení:"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Credentials are required to connect to “%s”."
msgstr "Pro připojení k „%s“ jsou potřeba přihlašovací údaje."

#: plugins/gnome/nm-gpclient-editor-common.h plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Custom..."
msgstr "Vlastní..."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "DNS Servers:"
msgstr "Servery DNS:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: built-in HIP report"
msgstr "Prázdné: vestavěná zpráva HIP"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable HIP (Host Integrity Protection) to send host information to the VPN gateway.\n"
"This is required by some organizations for security compliance."
msgstr ""
"Zapněte HIP (Host Integrity Protection), aby se informace o hostiteli odesílaly bráně VPN.\n"
"Některé organizace to vyžadují pro soulad s bezpečnostními pravidly."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Enable Host Integrity Protection (HIP)"
msgstr "Zapnout Host Integrity Protection (HIP)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable when the address above is a gateway rather than a portal.\n"
"Without this the portal workflow is tried first, which can make you authenticate twice."
msgstr ""
"Zapněte, pokud je adresa výše brána, a ne portál.\n"
"Bez toho se nejprve zkusí postup přes portál, kvůli čemuž se můžete muset ověřit dvakrát."

#: plugins/gnome/nm-gpclient-editor-common.h
msgid "First proposed by portal (automatic)"
msgstr "První navržená portálem (automaticky)"

#: plugins/gnome/nm-gpclient-editor-plugin.c
#: plugins/gnome/nm-gpclient-plugin-simple.c
msgid "GlobalProtect VPN Client"
msgstr "Klient VPN GlobalProtect"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP script:"
msgstr "Skript HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP:"
msgstr "HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"How long NetworkManager waits for the VPN to connect, including the login in the browser (vpn.timeout).\n"
"0 uses the NetworkManager default, usually 60 s - often too short for a SAML login with MFA. A new connection with browser authentication starts with 360 s. While a connection has no timeout of its own (0) and you have not changed this field, choosing browser authentication sets 360 s."
msgstr ""
"Jak dlouho NetworkManager čeká na připojení VPN včetně přihlášení v prohlížeči (vpn.timeout).\n"
"0 použije výchozí hodnotu NetworkManageru, obvykle 60 s – to je často příliš krátké pro přihlášení SAML s MFA. Nové připojení s ověřením v prohlížeči začíná na 360 s. Dokud připojení nemá vlastní časový limit (0) a toto pole jste neměnili, volba ověření v prohlížeči nastaví 360 s."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Legacy TLS renegotiation:"
msgstr "Starší opětovné vyjednání TLS:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "MTU:"
msgstr "MTU:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Maximum size of a packet in the tunnel.\n"
"0 = Automatic. Lowering it (for example to 1300-1400) may help when the tunnel falls back from ESP to HTTPS with \"Message too long\".\n"
"It has an effect only when the gateway sends no MTU of its own. Values from 1 to 575 are saved as 576, the lowest value that is used."
msgstr ""
"Maximální velikost paketu v tunelu.\n"
"0 = Automaticky. Snížení (například na 1300-1400) může pomoci, když tunel přejde z ESP na HTTPS se zprávou „Message too long“.\n"
"Má účinek jen tehdy, když brána neposílá vlastní MTU. Hodnoty od 1 do 575 se uloží jako 576, nejnižší použitá hodnota."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Never"
msgstr "Nikdy"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to a custom HIP executable, passed to gpclient as --hip=<path>.\n"
"The service runs it as root: it must be a root-owned file that is not writable by group or others, in root-owned directories that are not writable by group or others. Otherwise the connection fails.\n"
"Ignored when HIP is off."
msgstr ""
"Volitelná absolutní cesta k vlastnímu spustitelnému souboru HIP, který se předá programu gpclient jako --hip=<path>.\n"
"Služba jej spouští jako root: musí to být soubor vlastněný uživatelem root, do kterého nemůže zapisovat skupina ani ostatní, v adresářích vlastněných uživatelem root, do kterých nemůže zapisovat skupina ani ostatní. Jinak připojení selže.\n"
"Ignoruje se, když je HIP vypnuté."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Use the icon in the field to choose where the password is kept: for this user only, for all users, or not at all (asked every time)."
msgstr "Volitelné. Pomocí ikony v poli zvolte, kde se heslo uchovává: jen pro tohoto uživatele, pro všechny uživatele, nebo nikde (ptá se pokaždé)."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Used by portals that ask for credentials on the terminal, so you are not asked for the username every time."
msgstr "Volitelné. Používají portály, které se ptají na přihlašovací údaje v terminálu, abyste nemuseli pokaždé zadávat uživatelské jméno."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Password"
msgstr "Heslo"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Password:"
msgstr "Heslo:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Portal or gateway address:"
msgstr "Adresa portálu nebo brány:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Portals with an old TLS stack need renegotiation that OpenSSL 3 refuses by default.\n"
"Automatic: retry once with the workaround when the portal asks for it, and switch this setting to \"Always on\" afterwards, so the failed first attempt does not repeat."
msgstr ""
"Portály se starým zásobníkem TLS potřebují opětovné vyjednání, které OpenSSL 3 ve výchozím stavu odmítá.\n"
"Automaticky: když o to portál požádá, zkusí se to jednou znovu s obejitím a poté se toto nastavení přepne na „Vždy zapnuto“, aby se neúspěšný první pokus neopakoval."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Preferred gateway:"
msgstr "Upřednostňovaná brána:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Recommended: Leave empty to use DNS servers from VPN with automatic split DNS configuration.\n"
"Split DNS allows resolving VPN-specific domains through VPN DNS while using local DNS for other domains.\n"
"Override: Enter semicolon-separated DNS servers (e.g., 8.8.8.8;8.8.4.4) to use custom DNS instead."
msgstr ""
"Doporučeno: nechte prázdné, aby se použily servery DNS z VPN s automatickou konfigurací split DNS.\n"
"Split DNS umožňuje překládat domény specifické pro VPN přes DNS VPN a pro ostatní domény používat místní DNS.\n"
"Přepsat: zadejte servery DNS oddělené středníkem (např. 8.8.8.8;8.8.4.4), aby se místo toho použily vlastní servery DNS."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Token / one-time code"
msgstr "Token / jednorázový kód"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "User: %s"
msgstr "Uživatel: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Username"
msgstr "Uživatelské jméno"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username and password (RSA token)"
msgstr "Uživatelské jméno a heslo (token RSA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username:"
msgstr "Uživatelské jméno:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Which gateway to connect to. The list is filled in after the first successful connection.\n"
"If the chosen gateway is not offered by the portal any more, the first proposal is used instead."
msgstr ""
"K jaké bráně se připojit. Seznam se vyplní po prvním úspěšném připojení.\n"
"Pokud portál zvolenou bránu už nenabízí, použije se první návrh."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_Cancel"
msgstr "_Zrušit"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_OK"
msgstr "_OK"

#: plugins/gnome/nm-gpclient-validate.h
msgid "browser must be a name, a command name or an absolute path without spaces"
msgstr "browser musí být název, název příkazu nebo absolutní cesta bez mezer"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "bytes (0 = Automatic)"
msgstr "bajtů (0 = automaticky)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "dns must be IPv4 or IPv6 addresses separated by commas, semicolons or spaces"
msgstr "dns musí být adresy IPv4 nebo IPv6 oddělené čárkami, středníky nebo mezerami"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway is required"
msgstr "gateway je povinné"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway must not start with '-' or contain spaces or control characters"
msgstr "gateway nesmí začínat znakem „-“ ani obsahovat mezery či řídicí znaky"

#: plugins/gnome/nm-gpclient-validate.h
msgid "hip-script must be an absolute path"
msgstr "hip-script musí být absolutní cesta"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "seconds (0 = NetworkManager default)"
msgstr "sekund (0 = výchozí hodnota NetworkManageru)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "username must not start with '-' or contain control characters"
msgstr "username nesmí začínat znakem „-“ ani obsahovat řídicí znaky"

#: plugins/gnome/nm-gpclient-keyfile.h
msgid "The file is not a GlobalProtect VPN connection"
msgstr "Soubor není připojení GlobalProtect VPN"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "SAML login:"
msgstr "Přihlášení SAML:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the service (default)"
msgstr "Ve službě (výchozí)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the login dialog"
msgstr "V přihlašovacím dialogu"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Where the browser login runs: in the service, or in the login dialog (in your session)."
msgstr "Kde běží přihlášení v prohlížeči: ve službě, nebo v přihlašovacím dialogu (ve vaší relaci)."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Certificate passphrase"
msgstr "Heslo certifikátu"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Certificate passphrase:"
msgstr "Heslo certifikátu:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Client certificate:"
msgstr "Klientský certifikát:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: no client certificate"
msgstr "Prázdné: bez klientského certifikátu"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: the key is in the certificate file"
msgstr "Prázdné: klíč je v souboru certifikátu"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the client certificate file (PEM or PKCS#12), "
"owned by your desktop user."
msgstr "Volitelná absolutní cesta k souboru klientského certifikátu (PEM nebo PKCS#12), který vlastní uživatel plochy."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the private key file (PEM), owned by your "
"desktop user. Ignored without a client certificate."
msgstr "Volitelná absolutní cesta k souboru soukromého klíče (PEM), který vlastní uživatel plochy. Bez klientského certifikátu se ignoruje."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Private key:"
msgstr "Soukromý klíč:"

#: plugins/gnome/nm-gpclient-validate.h
msgid "usercert must be an absolute path"
msgstr "usercert musí být absolutní cesta"

#: plugins/gnome/nm-gpclient-validate.h
msgid "userkey must be an absolute path"
msgstr "userkey musí být absolutní cesta"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose a file"
msgstr "Vybrat soubor"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the client certificate"
msgstr "Vyberte klientský certifikát"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the private key"
msgstr "Vyberte soukromý klíč"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the HIP script"
msgstr "Vyberte skript HIP"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Let NetworkManager set the routes and DNS (experimental)"
msgstr "Nechat NetworkManager nastavit trasy a DNS (experimentální)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "NetworkManager configures the tunnel's routes, DNS and default route from what the gateway sends, instead of vpnc-script. Routes the gateway excludes from the tunnel are ignored."
msgstr "NetworkManager nastaví trasy, DNS a výchozí trasu tunelu podle údajů z brány místo skriptu vpnc-script. Trasy, které brána z tunelu vylučuje, se ignorují."
