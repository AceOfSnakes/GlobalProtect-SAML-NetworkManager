#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "%s:"
msgstr "%s:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Address is a gateway (skip the portal)"
msgstr "L'indirizzo è un gateway (salta il portale)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Address of the GlobalProtect portal (e.g. vpn.company.com).\n"
"If your organisation gave you a gateway address instead, also tick \"Address is a gateway\" below."
msgstr ""
"Indirizzo del portale GlobalProtect (ad es. vpn.company.com).\n"
"Se la tua organizzazione ti ha dato l'indirizzo di un gateway, seleziona anche «L'indirizzo è un gateway» qui sotto."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Always on"
msgstr "Sempre attivo"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authenticate VPN: %s"
msgstr "Autentica VPN: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authentication failed. Enter the credentials for “%s” again."
msgstr "Autenticazione non riuscita. Inserisci di nuovo le credenziali per “%s”."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Authentication:"
msgstr "Autenticazione:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Automatic (enable when the portal needs it)"
msgstr "Automatico (attiva quando il portale lo richiede)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser (SAML, passkey, 2FA)"
msgstr "Browser (SAML, passkey, 2FA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser used for SAML/2FA authentication. \"edge\" is the best tested option; \"default\" uses your desktop's default browser.\n"
"Select 'Custom...' to give the full path to your own executable."
msgstr ""
"Browser usato per l'autenticazione SAML/2FA. «edge» è l'opzione meglio testata; «default» usa il browser predefinito del desktop.\n"
"Seleziona «Personalizzato...» per indicare il percorso completo del tuo eseguibile."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser:"
msgstr "Browser:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser: the portal opens a browser window for single sign-on (default).\n"
"Username and password: the portal asks on the terminal - the credentials and any token are requested in a dialog instead."
msgstr ""
"Browser: il portale apre una finestra del browser per il single sign-on (predefinito).\n"
"Nome utente e password: il portale chiede sul terminale - le credenziali ed eventuali token sono invece richiesti in una finestra di dialogo."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Connect timeout:"
msgstr "Timeout di connessione:"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Credentials are required to connect to “%s”."
msgstr "Sono necessarie le credenziali per connettersi a “%s”."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Custom..."
msgstr "Personalizzato..."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "DNS Servers:"
msgstr "Server DNS:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: built-in HIP report"
msgstr "Vuoto: report HIP integrato"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable HIP (Host Integrity Protection) to send host information to the VPN gateway.\n"
"This is required by some organizations for security compliance."
msgstr ""
"Attiva HIP (Host Integrity Protection) per inviare le informazioni sull'host al gateway VPN.\n"
"Alcune organizzazioni lo richiedono per la conformità di sicurezza."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Enable Host Integrity Protection (HIP)"
msgstr "Attiva Host Integrity Protection (HIP)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable when the address above is a gateway rather than a portal.\n"
"Without this the portal workflow is tried first, which can make you authenticate twice."
msgstr ""
"Attiva quando l'indirizzo qui sopra è un gateway e non un portale.\n"
"Senza questa opzione si prova prima il flusso del portale, e potresti dover autenticarti due volte."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "First proposed by portal (automatic)"
msgstr "Il primo proposto dal portale (automatico)"

#: plugins/gnome/nm-gpclient-editor-plugin.c
#: plugins/gnome/nm-gpclient-plugin-simple.c
msgid "GlobalProtect VPN Client"
msgstr "Client VPN GlobalProtect"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP script:"
msgstr "Script HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP:"
msgstr "HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"How long NetworkManager waits for the VPN to connect, including the login in the browser (vpn.timeout).\n"
"0 uses the NetworkManager default, usually 60 s - often too short for a SAML login with MFA. A new connection with browser authentication starts with 360 s. While a connection has no timeout of its own (0) and you have not changed this field, choosing browser authentication sets 360 s."
msgstr ""
"Quanto tempo NetworkManager attende la connessione della VPN, compreso l'accesso nel browser (vpn.timeout).\n"
"0 usa il valore predefinito di NetworkManager, di solito 60 s - spesso troppo breve per un accesso SAML con MFA. Una nuova connessione con autenticazione tramite browser parte con 360 s. Finché una connessione non ha un timeout proprio (0) e non hai modificato questo campo, scegliere l'autenticazione tramite browser imposta 360 s."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Legacy TLS renegotiation:"
msgstr "Rinegoziazione TLS legacy:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "MTU:"
msgstr "MTU:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Maximum size of a packet in the tunnel.\n"
"0 = Automatic. Lowering it (for example to 1300-1400) may help when the tunnel falls back from ESP to HTTPS with \"Message too long\".\n"
"It has an effect only when the gateway sends no MTU of its own. Values from 1 to 575 are saved as 576, the lowest value that is used."
msgstr ""
"Dimensione massima di un pacchetto nel tunnel.\n"
"0 = Automatico. Ridurla (ad esempio a 1300-1400) può aiutare quando il tunnel passa da ESP a HTTPS con «Message too long».\n"
"Ha effetto solo quando il gateway non invia un MTU proprio. I valori da 1 a 575 sono salvati come 576, il valore più basso usato."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Never"
msgstr "Mai"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to a custom HIP executable, passed to gpclient as --hip=<path>.\n"
"The service runs it as root: it must be a root-owned file that is not writable by group or others, in root-owned directories that are not writable by group or others. Otherwise the connection fails.\n"
"Ignored when HIP is off."
msgstr ""
"Facoltativo. Percorso assoluto di un eseguibile HIP personalizzato, passato a gpclient come --hip=<path>.\n"
"Il servizio lo esegue come root: deve essere un file di proprietà di root, non scrivibile da gruppo o altri, in directory di proprietà di root non scrivibili da gruppo o altri. Altrimenti la connessione non riesce.\n"
"Ignorato quando HIP è disattivato."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Use the icon in the field to choose where the password is kept: for this user only, for all users, or not at all (asked every time)."
msgstr "Facoltativo. Usa l'icona nel campo per scegliere dove viene conservata la password: solo per questo utente, per tutti gli utenti o per nulla (richiesta ogni volta)."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Used by portals that ask for credentials on the terminal, so you are not asked for the username every time."
msgstr "Facoltativo. Usato dai portali che chiedono le credenziali sul terminale, così non ti viene chiesto il nome utente ogni volta."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Password"
msgstr "Password"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Password:"
msgstr "Password:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Portal or gateway address:"
msgstr "Indirizzo del portale o del gateway:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Portals with an old TLS stack need renegotiation that OpenSSL 3 refuses by default.\n"
"Automatic: retry once with the workaround when the portal asks for it, and switch this setting to \"Always on\" afterwards, so the failed first attempt does not repeat."
msgstr ""
"I portali con uno stack TLS vecchio richiedono una rinegoziazione che OpenSSL 3 rifiuta per impostazione predefinita.\n"
"Automatico: riprova una volta con la soluzione alternativa quando il portale lo richiede, poi imposta questa opzione su «Sempre attivo», così il primo tentativo non riuscito non si ripete."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Preferred gateway:"
msgstr "Gateway preferito:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Recommended: Leave empty to use DNS servers from VPN with automatic split DNS configuration.\n"
"Split DNS allows resolving VPN-specific domains through VPN DNS while using local DNS for other domains.\n"
"Override: Enter semicolon-separated DNS servers (e.g., 8.8.8.8;8.8.4.4) to use custom DNS instead."
msgstr ""
"Consigliato: lascia vuoto per usare i server DNS della VPN con la configurazione automatica dello split DNS.\n"
"Lo split DNS permette di risolvere i domini specifici della VPN tramite il DNS della VPN, usando il DNS locale per gli altri domini.\n"
"Sostituzione: inserisci server DNS separati da punto e virgola (ad es. 8.8.8.8;8.8.4.4) per usare un DNS personalizzato."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Token / one-time code"
msgstr "Token / codice monouso"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "User: %s"
msgstr "Utente: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Username"
msgstr "Nome utente"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username and password (RSA token)"
msgstr "Nome utente e password (token RSA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username:"
msgstr "Nome utente:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Which gateway to connect to. The list is filled in after the first successful connection.\n"
"If the chosen gateway is not offered by the portal any more, the first proposal is used instead."
msgstr ""
"Gateway a cui connettersi. L'elenco viene riempito dopo la prima connessione riuscita.\n"
"Se il gateway scelto non è più offerto dal portale, viene usata la prima proposta."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_Cancel"
msgstr "_Annulla"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_OK"
msgstr "_OK"

#: plugins/gnome/nm-gpclient-validate.h
msgid "browser must be a name, a command name or an absolute path without spaces"
msgstr "browser deve essere un nome, un nome di comando o un percorso assoluto senza spazi"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "bytes (0 = Automatic)"
msgstr "byte (0 = Automatico)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "dns must be IPv4 or IPv6 addresses separated by commas, semicolons or spaces"
msgstr "dns deve essere composto da indirizzi IPv4 o IPv6 separati da virgole, punti e virgola o spazi"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway is required"
msgstr "gateway è obbligatorio"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway must not start with '-' or contain spaces or control characters"
msgstr "gateway non deve iniziare con '-' né contenere spazi o caratteri di controllo"

#: plugins/gnome/nm-gpclient-validate.h
msgid "hip-script must be an absolute path"
msgstr "hip-script deve essere un percorso assoluto"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "seconds (0 = NetworkManager default)"
msgstr "secondi (0 = predefinito di NetworkManager)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "username must not start with '-' or contain control characters"
msgstr "username non deve iniziare con '-' né contenere caratteri di controllo"

#: plugins/gnome/nm-gpclient-keyfile.h
msgid "The file is not a GlobalProtect VPN connection"
msgstr "Il file non è una connessione VPN GlobalProtect"
