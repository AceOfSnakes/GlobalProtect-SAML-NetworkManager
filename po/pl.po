#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "%s:"
msgstr "%s:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Address is a gateway (skip the portal)"
msgstr "Adres jest bramą (pomiń portal)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Address of the GlobalProtect portal (e.g. vpn.company.com).\n"
"If your organisation gave you a gateway address instead, also tick \"Address "
"is a gateway\" below."
msgstr ""
"Adres portalu GlobalProtect (np. vpn.firma.pl).\n"
"Jeśli organizacja podała adres bramy, zaznacz też poniżej „Adres jest bramą”."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Always on"
msgstr "Zawsze włączone"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authenticate VPN: %s"
msgstr "Uwierzytelnianie VPN: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authentication failed. Enter the credentials for “%s” again."
msgstr "Uwierzytelnianie nie powiodło się. Wpisz ponownie dane logowania do „%s”."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Authentication:"
msgstr "Uwierzytelnianie:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Automatic (enable when the portal needs it)"
msgstr "Automatycznie (włącz, gdy portal tego wymaga)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser (SAML, passkey, 2FA)"
msgstr "Przeglądarka (SAML, klucz dostępu, 2FA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser used for SAML/2FA authentication. \"edge\" is the best tested "
"option; \"default\" uses your desktop's default browser.\n"
"Select 'Custom...' to give the full path to your own executable."
msgstr ""
"Przeglądarka do uwierzytelniania SAML/2FA. „edge” jest najlepiej przetestowana; „default” używa domyślnej przeglądarki pulpitu.\n"
"Wybierz „Własna...”, aby podać pełną ścieżkę do własnego pliku wykonywalnego."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser:"
msgstr "Przeglądarka:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser: the portal opens a browser window for single sign-on (default).\n"
"Username and password: the portal asks on the terminal - the credentials and "
"any token are requested in a dialog instead."
msgstr ""
"Przeglądarka: portal otwiera okno przeglądarki do logowania jednokrotnego (domyślnie).\n"
"Nazwa użytkownika i hasło: portal pyta w terminalu - dane logowania i token są wtedy wymagane w oknie dialogowym."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Connect timeout:"
msgstr "Limit czasu połączenia:"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Credentials are required to connect to “%s”."
msgstr "Połączenie z „%s” wymaga danych logowania."

#: plugins/gnome/nm-gpclient-editor-common.h plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Custom..."
msgstr "Własna..."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "DNS Servers:"
msgstr "Serwery DNS:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: built-in HIP report"
msgstr "Puste: wbudowany raport HIP"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable HIP (Host Integrity Protection) to send host information to the VPN "
"gateway.\n"
"This is required by some organizations for security compliance."
msgstr ""
"Włącz HIP (Host Integrity Protection), aby wysyłać informacje o komputerze do bramy VPN.\n"
"Niektóre organizacje wymagają tego ze względu na zgodność z zasadami bezpieczeństwa."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Enable Host Integrity Protection (HIP)"
msgstr "Włącz ochronę integralności hosta (HIP)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable when the address above is a gateway rather than a portal.\n"
"Without this the portal workflow is tried first, which can make you "
"authenticate twice."
msgstr ""
"Włącz, gdy powyższy adres jest bramą, a nie portalem.\n"
"Bez tej opcji najpierw jest używany przebieg dla portalu, co może wymagać dwukrotnego uwierzytelnienia."

#: plugins/gnome/nm-gpclient-editor-common.h
msgid "First proposed by portal (automatic)"
msgstr "Pierwsza zaproponowana przez portal (automatycznie)"

#: plugins/gnome/nm-gpclient-editor-plugin.c
#: plugins/gnome/nm-gpclient-plugin-simple.c
msgid "GlobalProtect VPN Client"
msgstr "Klient VPN GlobalProtect"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP script:"
msgstr "Skrypt HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP:"
msgstr "HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"How long NetworkManager waits for the VPN to connect, including the login in "
"the browser (vpn.timeout).\n"
"0 uses the NetworkManager default, usually 60 s - often too short for a SAML "
"login with MFA. A new connection with browser authentication starts with 360 "
"s. While a connection has no timeout of its own (0) and you have not changed "
"this field, choosing browser authentication sets 360 s."
msgstr ""
"Jak długo NetworkManager czeka na połączenie VPN, razem z logowaniem w przeglądarce (vpn.timeout).\n"
"0 oznacza wartość domyślną NetworkManagera, zwykle 60 s - często za mało na logowanie SAML z MFA. Nowe połączenie z uwierzytelnianiem w przeglądarce zaczyna od 360 s. Dopóki połączenie nie ma własnego limitu (0), a to pole nie zostało zmienione, wybór uwierzytelniania w przeglądarce ustawia 360 s."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Legacy TLS renegotiation:"
msgstr "Starsza renegocjacja TLS:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "MTU:"
msgstr "MTU:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Maximum size of a packet in the tunnel.\n"
"0 = Automatic. Lowering it (for example to 1300-1400) may help when the "
"tunnel falls back from ESP to HTTPS with \"Message too long\".\n"
"It has an effect only when the gateway sends no MTU of its own. Values from "
"1 to 575 are saved as 576, the lowest value that is used."
msgstr ""
"Maksymalny rozmiar pakietu w tunelu.\n"
"0 = automatycznie. Zmniejszenie wartości (np. do 1300-1400) może pomóc, gdy tunel przechodzi z ESP na HTTPS z błędem „Message too long”.\n"
"Ma to skutek tylko wtedy, gdy brama nie wysyła własnej wartości MTU. Wartości od 1 do 575 są zapisywane jako 576, czyli najniższa używana wartość."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Never"
msgstr "Nigdy"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to a custom HIP executable, passed to gpclient as --"
"hip=<path>.\n"
"The service runs it as root: it must be a root-owned file that is not "
"writable by group or others, in root-owned directories that are not writable "
"by group or others. Otherwise the connection fails.\n"
"Ignored when HIP is off."
msgstr ""
"Opcjonalna bezwzględna ścieżka do własnego pliku wykonywalnego HIP, przekazywana do gpclient jako --hip=<path>.\n"
"Usługa uruchamia go jako root: to musi być plik należący do roota, bez prawa zapisu dla grupy i innych, w katalogach należących do roota, bez prawa zapisu dla grupy i innych. W przeciwnym razie połączenie się nie uda.\n"
"Ignorowane, gdy HIP jest wyłączony."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional. Use the icon in the field to choose where the password is kept: "
"for this user only, for all users, or not at all (asked every time)."
msgstr "Opcjonalne. Ikona w polu pozwala wybrać, gdzie przechowywać hasło: tylko dla tego użytkownika, dla wszystkich użytkowników albo wcale (pytanie za każdym razem)."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional. Used by portals that ask for credentials on the terminal, so you "
"are not asked for the username every time."
msgstr "Opcjonalne. Używane przez portale, które pytają o dane logowania w terminalu, aby nie trzeba było za każdym razem wpisywać nazwy użytkownika."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Password"
msgstr "Hasło"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Password:"
msgstr "Hasło:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Portal or gateway address:"
msgstr "Adres portalu lub bramy:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Portals with an old TLS stack need renegotiation that OpenSSL 3 refuses by "
"default.\n"
"Automatic: retry once with the workaround when the portal asks for it, and "
"switch this setting to \"Always on\" afterwards, so the failed first attempt "
"does not repeat."
msgstr ""
"Portale ze starym stosem TLS wymagają renegocjacji, której OpenSSL 3 domyślnie odmawia.\n"
"Automatycznie: ponów raz z obejściem, gdy portal tego wymaga, a potem przełącz to ustawienie na „Zawsze włączone”, aby nieudana pierwsza próba się nie powtarzała."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Preferred gateway:"
msgstr "Preferowana brama:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Recommended: Leave empty to use DNS servers from VPN with automatic split "
"DNS configuration.\n"
"Split DNS allows resolving VPN-specific domains through VPN DNS while using "
"local DNS for other domains.\n"
"Override: Enter semicolon-separated DNS servers (e.g., 8.8.8.8;8.8.4.4) to "
"use custom DNS instead."
msgstr ""
"Zalecane: zostaw puste, aby użyć serwerów DNS z VPN z automatyczną konfiguracją dzielonego DNS.\n"
"Dzielony DNS rozwiązuje nazwy domen VPN przez DNS z VPN, a inne domeny przez lokalny DNS.\n"
"Zastąpienie: wpisz serwery DNS oddzielone średnikami (np. 8.8.8.8;8.8.4.4), aby użyć własnych serwerów DNS."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Token / one-time code"
msgstr "Token / kod jednorazowy"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "User: %s"
msgstr "Użytkownik: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Username"
msgstr "Nazwa użytkownika"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username and password (RSA token)"
msgstr "Nazwa użytkownika i hasło (token RSA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username:"
msgstr "Nazwa użytkownika:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Which gateway to connect to. The list is filled in after the first "
"successful connection.\n"
"If the chosen gateway is not offered by the portal any more, the first "
"proposal is used instead."
msgstr ""
"Z którą bramą się połączyć. Lista wypełnia się po pierwszym udanym połączeniu.\n"
"Jeśli wybrana brama nie jest już oferowana przez portal, jest używana pierwsza propozycja."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_Cancel"
msgstr "_Anuluj"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_OK"
msgstr "_OK"

#: plugins/gnome/nm-gpclient-validate.h
msgid ""
"browser must be a name, a command name or an absolute path without spaces"
msgstr "przeglądarka musi być nazwą, nazwą polecenia lub bezwzględną ścieżką bez spacji"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "bytes (0 = Automatic)"
msgstr "bajtów (0 = automatycznie)"

#: plugins/gnome/nm-gpclient-validate.h
msgid ""
"dns must be IPv4 or IPv6 addresses separated by commas, semicolons or spaces"
msgstr "dns musi zawierać adresy IPv4 lub IPv6 oddzielone przecinkami, średnikami lub spacjami"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway is required"
msgstr "brama jest wymagana"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway must not start with '-' or contain spaces or control characters"
msgstr "brama nie może zaczynać się od „-” ani zawierać spacji lub znaków sterujących"

#: plugins/gnome/nm-gpclient-validate.h
msgid "hip-script must be an absolute path"
msgstr "hip-script musi być ścieżką bezwzględną"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "seconds (0 = NetworkManager default)"
msgstr "sekund (0 = domyślny NetworkManagera)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "username must not start with '-' or contain control characters"
msgstr "nazwa użytkownika nie może zaczynać się od „-” ani zawierać znaków sterujących"

#: plugins/gnome/nm-gpclient-keyfile.h
msgid "The file is not a GlobalProtect VPN connection"
msgstr "Plik nie jest połączeniem VPN GlobalProtect"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Certificate passphrase"
msgstr "Hasło certyfikatu"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Certificate passphrase:"
msgstr "Hasło certyfikatu:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Client certificate:"
msgstr "Certyfikat klienta:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: no client certificate"
msgstr "Puste: brak certyfikatu klienta"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: the key is in the certificate file"
msgstr "Puste: klucz jest w pliku certyfikatu"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the client certificate file (PEM or PKCS#12), "
"readable by your desktop user."
msgstr "Opcjonalna ścieżka bezwzględna do pliku certyfikatu klienta (PEM lub PKCS#12), który musi być czytelny dla użytkownika pulpitu."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the private key file (PEM), readable by your "
"desktop user. Ignored without a client certificate."
msgstr "Opcjonalna ścieżka bezwzględna do pliku klucza prywatnego (PEM), który musi być czytelny dla użytkownika pulpitu. Ignorowana bez certyfikatu klienta."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Private key:"
msgstr "Klucz prywatny:"

#: plugins/gnome/nm-gpclient-validate.h
msgid "usercert must be an absolute path"
msgstr "usercert musi być ścieżką bezwzględną"

#: plugins/gnome/nm-gpclient-validate.h
msgid "userkey must be an absolute path"
msgstr "userkey musi być ścieżką bezwzględną"
