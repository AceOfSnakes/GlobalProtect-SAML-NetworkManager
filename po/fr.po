#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "%s:"
msgstr "%s :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Address is a gateway (skip the portal)"
msgstr "L’adresse est une passerelle (ignorer le portail)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Address of the GlobalProtect portal (e.g. vpn.company.com).\n"
"If your organisation gave you a gateway address instead, also tick \"Address is a gateway\" below."
msgstr ""
"Adresse du portail GlobalProtect (p. ex. vpn.company.com).\n"
"Si votre organisation vous a donné une adresse de passerelle, cochez aussi « L’adresse est une passerelle » ci-dessous."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Always on"
msgstr "Toujours activé"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authenticate VPN: %s"
msgstr "Authentifier le VPN : %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authentication failed. Enter the credentials for “%s” again."
msgstr "L’authentification a échoué. Saisissez à nouveau les identifiants pour « %s »."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Authentication:"
msgstr "Authentification :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Automatic (enable when the portal needs it)"
msgstr "Automatique (activé quand le portail l’exige)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser (SAML, passkey, 2FA)"
msgstr "Navigateur (SAML, passkey, 2FA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser used for SAML/2FA authentication. \"edge\" is the best tested option; \"default\" uses your desktop's default browser.\n"
"Select 'Custom...' to give the full path to your own executable."
msgstr ""
"Navigateur utilisé pour l’authentification SAML/2FA. « edge » est l’option la mieux testée ; « default » utilise le navigateur par défaut de votre bureau.\n"
"Choisissez « Personnalisé... » pour indiquer le chemin complet de votre propre exécutable."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser:"
msgstr "Navigateur :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser: the portal opens a browser window for single sign-on (default).\n"
"Username and password: the portal asks on the terminal - the credentials and any token are requested in a dialog instead."
msgstr ""
"Navigateur : le portail ouvre une fenêtre de navigateur pour l’authentification unique (par défaut).\n"
"Nom d’utilisateur et mot de passe : le portail interroge sur le terminal - les identifiants et l’éventuel jeton sont alors demandés dans une boîte de dialogue."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Connect timeout:"
msgstr "Délai de connexion :"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Credentials are required to connect to “%s”."
msgstr "Des identifiants sont requis pour se connecter à « %s »."

#: plugins/gnome/nm-gpclient-editor-common.h plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Custom..."
msgstr "Personnalisé..."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "DNS Servers:"
msgstr "Serveurs DNS :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: built-in HIP report"
msgstr "Vide : rapport HIP intégré"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable HIP (Host Integrity Protection) to send host information to the VPN gateway.\n"
"This is required by some organizations for security compliance."
msgstr ""
"Activez HIP (Host Integrity Protection) pour envoyer les informations de l’hôte à la passerelle VPN.\n"
"Certaines organisations l’exigent pour la conformité de sécurité."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Enable Host Integrity Protection (HIP)"
msgstr "Activer la protection de l’intégrité de l’hôte (HIP)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable when the address above is a gateway rather than a portal.\n"
"Without this the portal workflow is tried first, which can make you authenticate twice."
msgstr ""
"Activez cette option quand l’adresse ci-dessus est une passerelle et non un portail.\n"
"Sans elle, le flux du portail est essayé en premier, ce qui peut vous obliger à vous authentifier deux fois."

#: plugins/gnome/nm-gpclient-editor-common.h
msgid "First proposed by portal (automatic)"
msgstr "Première proposée par le portail (automatique)"

#: plugins/gnome/nm-gpclient-editor-plugin.c
#: plugins/gnome/nm-gpclient-plugin-simple.c
msgid "GlobalProtect VPN Client"
msgstr "Client VPN GlobalProtect"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP script:"
msgstr "Script HIP :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP:"
msgstr "HIP :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"How long NetworkManager waits for the VPN to connect, including the login in the browser (vpn.timeout).\n"
"0 uses the NetworkManager default, usually 60 s - often too short for a SAML login with MFA. A new connection with browser authentication starts with 360 s. While a connection has no timeout of its own (0) and you have not changed this field, choosing browser authentication sets 360 s."
msgstr ""
"Durée pendant laquelle NetworkManager attend la connexion du VPN, y compris la connexion dans le navigateur (vpn.timeout).\n"
"0 utilise la valeur par défaut de NetworkManager, généralement 60 s - souvent trop courte pour une connexion SAML avec MFA. Une nouvelle connexion avec authentification par navigateur démarre à 360 s. Tant qu’une connexion n’a pas de délai propre (0) et que vous n’avez pas modifié ce champ, le choix de l’authentification par navigateur définit 360 s."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Legacy TLS renegotiation:"
msgstr "Renégociation TLS héritée :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "MTU:"
msgstr "MTU :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Maximum size of a packet in the tunnel.\n"
"0 = Automatic. Lowering it (for example to 1300-1400) may help when the tunnel falls back from ESP to HTTPS with \"Message too long\".\n"
"It has an effect only when the gateway sends no MTU of its own. Values from 1 to 575 are saved as 576, the lowest value that is used."
msgstr ""
"Taille maximale d’un paquet dans le tunnel.\n"
"0 = Automatique. La réduire (par exemple à 1300-1400) peut aider quand le tunnel bascule d’ESP vers HTTPS avec « Message too long ».\n"
"Elle n’a d’effet que si la passerelle n’envoie pas de MTU propre. Les valeurs de 1 à 575 sont enregistrées comme 576, la plus petite valeur utilisée."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Never"
msgstr "Jamais"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to a custom HIP executable, passed to gpclient as --hip=<path>.\n"
"The service runs it as root: it must be a root-owned file that is not writable by group or others, in root-owned directories that are not writable by group or others. Otherwise the connection fails.\n"
"Ignored when HIP is off."
msgstr ""
"Facultatif. Chemin absolu d’un exécutable HIP personnalisé, transmis à gpclient sous la forme --hip=<path>.\n"
"Le service l’exécute en tant que root : ce doit être un fichier appartenant à root, non modifiable par le groupe ou les autres, dans des répertoires appartenant à root et non modifiables par le groupe ou les autres. Sinon, la connexion échoue.\n"
"Ignoré quand HIP est désactivé."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Use the icon in the field to choose where the password is kept: for this user only, for all users, or not at all (asked every time)."
msgstr "Facultatif. Utilisez l’icône du champ pour choisir où le mot de passe est conservé : pour cet utilisateur seulement, pour tous les utilisateurs, ou pas du tout (demandé à chaque fois)."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Used by portals that ask for credentials on the terminal, so you are not asked for the username every time."
msgstr "Facultatif. Utilisé par les portails qui demandent les identifiants sur le terminal, pour ne pas vous demander le nom d’utilisateur à chaque fois."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Password"
msgstr "Mot de passe"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Password:"
msgstr "Mot de passe :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Portal or gateway address:"
msgstr "Adresse du portail ou de la passerelle :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Portals with an old TLS stack need renegotiation that OpenSSL 3 refuses by default.\n"
"Automatic: retry once with the workaround when the portal asks for it, and switch this setting to \"Always on\" afterwards, so the failed first attempt does not repeat."
msgstr ""
"Les portails dotés d’une ancienne pile TLS exigent une renégociation que OpenSSL 3 refuse par défaut.\n"
"Automatique : réessayer une fois avec le contournement quand le portail le demande, puis passer ce paramètre à « Toujours activé », afin que la première tentative échouée ne se répète pas."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Preferred gateway:"
msgstr "Passerelle préférée :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Recommended: Leave empty to use DNS servers from VPN with automatic split DNS configuration.\n"
"Split DNS allows resolving VPN-specific domains through VPN DNS while using local DNS for other domains.\n"
"Override: Enter semicolon-separated DNS servers (e.g., 8.8.8.8;8.8.4.4) to use custom DNS instead."
msgstr ""
"Recommandé : laissez vide pour utiliser les serveurs DNS du VPN avec la configuration automatique du split DNS.\n"
"Le split DNS permet de résoudre les domaines propres au VPN via le DNS du VPN, tout en utilisant le DNS local pour les autres domaines.\n"
"Substitution : saisissez des serveurs DNS séparés par des points-virgules (p. ex. 8.8.8.8;8.8.4.4) pour utiliser un DNS personnalisé."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Token / one-time code"
msgstr "Jeton / code à usage unique"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "User: %s"
msgstr "Utilisateur : %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Username"
msgstr "Nom d’utilisateur"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username and password (RSA token)"
msgstr "Nom d’utilisateur et mot de passe (jeton RSA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username:"
msgstr "Nom d’utilisateur :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Which gateway to connect to. The list is filled in after the first successful connection.\n"
"If the chosen gateway is not offered by the portal any more, the first proposal is used instead."
msgstr ""
"Passerelle à laquelle se connecter. La liste est remplie après la première connexion réussie.\n"
"Si la passerelle choisie n’est plus proposée par le portail, la première proposition est utilisée à la place."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_Cancel"
msgstr "_Annuler"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_OK"
msgstr "_OK"

#: plugins/gnome/nm-gpclient-validate.h
msgid "browser must be a name, a command name or an absolute path without spaces"
msgstr "browser doit être un nom, un nom de commande ou un chemin absolu sans espaces"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "bytes (0 = Automatic)"
msgstr "octets (0 = automatique)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "dns must be IPv4 or IPv6 addresses separated by commas, semicolons or spaces"
msgstr "dns doit être composé d’adresses IPv4 ou IPv6 séparées par des virgules, des points-virgules ou des espaces"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway is required"
msgstr "gateway est requis"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway must not start with '-' or contain spaces or control characters"
msgstr "gateway ne doit pas commencer par « - » ni contenir d’espaces ou de caractères de contrôle"

#: plugins/gnome/nm-gpclient-validate.h
msgid "hip-script must be an absolute path"
msgstr "hip-script doit être un chemin absolu"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "seconds (0 = NetworkManager default)"
msgstr "secondes (0 = valeur par défaut de NetworkManager)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "username must not start with '-' or contain control characters"
msgstr "username ne doit pas commencer par « - » ni contenir de caractères de contrôle"

#: plugins/gnome/nm-gpclient-keyfile.h
msgid "The file is not a GlobalProtect VPN connection"
msgstr "Le fichier n'est pas une connexion VPN GlobalProtect"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "SAML login:"
msgstr "Connexion SAML :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the service (default)"
msgstr "Dans le service (par défaut)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the login dialog"
msgstr "Dans la boîte de dialogue de connexion"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Where the browser login runs: in the service, or in the login dialog (in your session)."
msgstr "Où s'exécute la connexion par navigateur : dans le service ou dans la boîte de dialogue de connexion (dans votre session)."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Certificate passphrase"
msgstr "Phrase secrète du certificat"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Certificate passphrase:"
msgstr "Phrase secrète du certificat:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Client certificate:"
msgstr "Certificat client :"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: no client certificate"
msgstr "Vide : pas de certificat client"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: the key is in the certificate file"
msgstr "Vide : la clé est dans le fichier du certificat"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the client certificate file (PEM or PKCS#12), "
"owned by your desktop user."
msgstr "Chemin absolu facultatif du fichier du certificat client (PEM ou PKCS#12), appartenant à l'utilisateur du bureau."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the private key file (PEM), owned by your "
"desktop user. Ignored without a client certificate."
msgstr "Chemin absolu facultatif du fichier de la clé privée (PEM), appartenant à l'utilisateur du bureau. Ignoré sans certificat client."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Private key:"
msgstr "Clé privée :"

#: plugins/gnome/nm-gpclient-validate.h
msgid "usercert must be an absolute path"
msgstr "usercert doit être un chemin absolu"

#: plugins/gnome/nm-gpclient-validate.h
msgid "userkey must be an absolute path"
msgstr "userkey doit être un chemin absolu"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose a file"
msgstr "Choisir un fichier"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the client certificate"
msgstr "Choisir le certificat client"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the private key"
msgstr "Choisir la clé privée"
