#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "%s:"
msgstr "%s:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Address is a gateway (skip the portal)"
msgstr "Adres is een gateway (portaal overslaan)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Address of the GlobalProtect portal (e.g. vpn.company.com).\n"
"If your organisation gave you a gateway address instead, also tick \"Address "
"is a gateway\" below."
msgstr ""
"Adres van het GlobalProtect-portaal (bijv. vpn.company.com).\n"
"Als uw organisatie u in plaats daarvan een gateway-adres gaf, vink dan hieronder ook ‘Adres is een gateway’ aan."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Always on"
msgstr "Altijd aan"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authenticate VPN: %s"
msgstr "VPN verifiëren: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authentication failed. Enter the credentials for “%s” again."
msgstr "Verificatie mislukt. Voer de inloggegevens voor “%s” opnieuw in."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Authentication:"
msgstr "Verificatie:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Automatic (enable when the portal needs it)"
msgstr "Automatisch (inschakelen wanneer het portaal het nodig heeft)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser (SAML, passkey, 2FA)"
msgstr "Browser (SAML, passkey, 2FA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser used for SAML/2FA authentication. \"edge\" is the best tested "
"option; \"default\" uses your desktop's default browser.\n"
"Select 'Custom...' to give the full path to your own executable."
msgstr ""
"Browser die wordt gebruikt voor SAML/2FA-verificatie. \"edge\" is de best geteste optie; \"default\" gebruikt de standaardbrowser van uw bureaublad.\n"
"Kies 'Aangepast...' om het volledige pad naar uw eigen uitvoerbare bestand op te geven."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser:"
msgstr "Browser:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser: the portal opens a browser window for single sign-on (default).\n"
"Username and password: the portal asks on the terminal - the credentials and "
"any token are requested in a dialog instead."
msgstr ""
"Browser: het portaal opent een browservenster voor eenmalige aanmelding (standaard).\n"
"Gebruikersnaam en wachtwoord: het portaal vraagt in de terminal - de inloggegevens en een eventueel token worden in plaats daarvan in een dialoogvenster gevraagd."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Connect timeout:"
msgstr "Verbindingstime-out:"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Credentials are required to connect to “%s”."
msgstr "Er zijn inloggegevens nodig om verbinding te maken met “%s”."

#: plugins/gnome/nm-gpclient-editor-common.h plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Custom..."
msgstr "Aangepast..."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "DNS Servers:"
msgstr "DNS-servers:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: built-in HIP report"
msgstr "Leeg: ingebouwd HIP-rapport"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable HIP (Host Integrity Protection) to send host information to the VPN "
"gateway.\n"
"This is required by some organizations for security compliance."
msgstr ""
"Schakel HIP (Host Integrity Protection) in om hostinformatie naar de VPN-gateway te sturen.\n"
"Dit is bij sommige organisaties vereist voor naleving van beveiligingsregels."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Enable Host Integrity Protection (HIP)"
msgstr "Host Integrity Protection (HIP) inschakelen"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable when the address above is a gateway rather than a portal.\n"
"Without this the portal workflow is tried first, which can make you "
"authenticate twice."
msgstr ""
"Schakel in wanneer het adres hierboven een gateway is en geen portaal.\n"
"Zonder dit wordt eerst de portaalprocedure geprobeerd, waardoor u mogelijk twee keer moet verifiëren."

#: plugins/gnome/nm-gpclient-editor-common.h
msgid "First proposed by portal (automatic)"
msgstr "Eerst voorgesteld door portaal (automatisch)"

#: plugins/gnome/nm-gpclient-editor-plugin.c
#: plugins/gnome/nm-gpclient-plugin-simple.c
msgid "GlobalProtect VPN Client"
msgstr "GlobalProtect VPN-client"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP script:"
msgstr "HIP-script:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP:"
msgstr "HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"How long NetworkManager waits for the VPN to connect, including the login in "
"the browser (vpn.timeout).\n"
"0 uses the NetworkManager default, usually 60 s - often too short for a SAML "
"login with MFA. A new connection with browser authentication starts with 360 "
"s. While a connection has no timeout of its own (0) and you have not changed "
"this field, choosing browser authentication sets 360 s."
msgstr ""
"Hoe lang NetworkManager wacht tot de VPN verbinding heeft, inclusief het aanmelden in de browser (vpn.timeout).\n"
"0 gebruikt de standaardwaarde van NetworkManager, meestal 60 s - vaak te kort voor een SAML-aanmelding met MFA. Een nieuwe verbinding met browserverificatie begint met 360 s. Zolang een verbinding geen eigen time-out heeft (0) en u dit veld niet hebt gewijzigd, stelt het kiezen van browserverificatie 360 s in."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Legacy TLS renegotiation:"
msgstr "Verouderde TLS-heronderhandeling:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "MTU:"
msgstr "MTU:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Maximum size of a packet in the tunnel.\n"
"0 = Automatic. Lowering it (for example to 1300-1400) may help when the "
"tunnel falls back from ESP to HTTPS with \"Message too long\".\n"
"It has an effect only when the gateway sends no MTU of its own. Values from "
"1 to 575 are saved as 576, the lowest value that is used."
msgstr ""
"Maximale grootte van een pakket in de tunnel.\n"
"0 = automatisch. Verlagen (bijvoorbeeld naar 1300-1400) kan helpen wanneer de tunnel van ESP terugvalt op HTTPS met \"Message too long\".\n"
"Het heeft alleen effect wanneer de gateway geen eigen MTU verstuurt. Waarden van 1 tot 575 worden opgeslagen als 576, de laagste waarde die wordt gebruikt."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Never"
msgstr "Nooit"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to a custom HIP executable, passed to gpclient as --"
"hip=<path>.\n"
"The service runs it as root: it must be a root-owned file that is not "
"writable by group or others, in root-owned directories that are not writable "
"by group or others. Otherwise the connection fails.\n"
"Ignored when HIP is off."
msgstr ""
"Optioneel absoluut pad naar een eigen HIP-programma, aan gpclient doorgegeven als --hip=<path>.\n"
"De service voert het uit als root: het moet een bestand van root zijn dat niet schrijfbaar is voor groep of anderen, in mappen van root die niet schrijfbaar zijn voor groep of anderen. Anders mislukt de verbinding.\n"
"Genegeerd wanneer HIP uit staat."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional. Use the icon in the field to choose where the password is kept: "
"for this user only, for all users, or not at all (asked every time)."
msgstr "Optioneel. Gebruik het pictogram in het veld om te kiezen waar het wachtwoord wordt bewaard: alleen voor deze gebruiker, voor alle gebruikers, of helemaal niet (elke keer gevraagd)."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional. Used by portals that ask for credentials on the terminal, so you "
"are not asked for the username every time."
msgstr "Optioneel. Wordt gebruikt door portalen die in de terminal om inloggegevens vragen, zodat er niet elke keer om de gebruikersnaam wordt gevraagd."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Password"
msgstr "Wachtwoord"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Password:"
msgstr "Wachtwoord:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Portal or gateway address:"
msgstr "Adres van portaal of gateway:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Portals with an old TLS stack need renegotiation that OpenSSL 3 refuses by "
"default.\n"
"Automatic: retry once with the workaround when the portal asks for it, and "
"switch this setting to \"Always on\" afterwards, so the failed first attempt "
"does not repeat."
msgstr ""
"Portalen met een oude TLS-stack hebben heronderhandeling nodig, die OpenSSL 3 standaard weigert.\n"
"Automatisch: probeer één keer opnieuw met de tijdelijke oplossing wanneer het portaal erom vraagt, en zet deze instelling daarna op \"Altijd aan\", zodat de mislukte eerste poging zich niet herhaalt."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Preferred gateway:"
msgstr "Voorkeursgateway:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Recommended: Leave empty to use DNS servers from VPN with automatic split "
"DNS configuration.\n"
"Split DNS allows resolving VPN-specific domains through VPN DNS while using "
"local DNS for other domains.\n"
"Override: Enter semicolon-separated DNS servers (e.g., 8.8.8.8;8.8.4.4) to "
"use custom DNS instead."
msgstr ""
"Aanbevolen: laat leeg om DNS-servers van de VPN te gebruiken met automatische split-DNS-configuratie.\n"
"Met split-DNS worden VPN-specifieke domeinen via de VPN-DNS omgezet en andere domeinen via de lokale DNS.\n"
"Overschrijven: voer door puntkomma's gescheiden DNS-servers in (bijv. 8.8.8.8;8.8.4.4) om in plaats daarvan eigen DNS te gebruiken."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Token / one-time code"
msgstr "Token / eenmalige code"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "User: %s"
msgstr "Gebruiker: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Username"
msgstr "Gebruikersnaam"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username and password (RSA token)"
msgstr "Gebruikersnaam en wachtwoord (RSA-token)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username:"
msgstr "Gebruikersnaam:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Which gateway to connect to. The list is filled in after the first "
"successful connection.\n"
"If the chosen gateway is not offered by the portal any more, the first "
"proposal is used instead."
msgstr ""
"Met welke gateway verbinding wordt gemaakt. De lijst wordt gevuld na de eerste geslaagde verbinding.\n"
"Als de gekozen gateway niet meer door het portaal wordt aangeboden, wordt in plaats daarvan het eerste voorstel gebruikt."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_Cancel"
msgstr "_Annuleren"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_OK"
msgstr "_OK"

#: plugins/gnome/nm-gpclient-validate.h
msgid ""
"browser must be a name, a command name or an absolute path without spaces"
msgstr "browser moet een naam, een opdrachtnaam of een absoluut pad zonder spaties zijn"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "bytes (0 = Automatic)"
msgstr "bytes (0 = automatisch)"

#: plugins/gnome/nm-gpclient-validate.h
msgid ""
"dns must be IPv4 or IPv6 addresses separated by commas, semicolons or spaces"
msgstr "dns moet bestaan uit IPv4- of IPv6-adressen gescheiden door komma's, puntkomma's of spaties"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway is required"
msgstr "gateway is vereist"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway must not start with '-' or contain spaces or control characters"
msgstr "gateway mag niet met '-' beginnen en geen spaties of besturingstekens bevatten"

#: plugins/gnome/nm-gpclient-validate.h
msgid "hip-script must be an absolute path"
msgstr "hip-script moet een absoluut pad zijn"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "seconds (0 = NetworkManager default)"
msgstr "seconden (0 = standaard van NetworkManager)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "username must not start with '-' or contain control characters"
msgstr "gebruikersnaam mag niet met '-' beginnen en geen besturingstekens bevatten"

#: plugins/gnome/nm-gpclient-keyfile.h
msgid "The file is not a GlobalProtect VPN connection"
msgstr "Het bestand is geen GlobalProtect-VPN-verbinding"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "SAML login:"
msgstr "SAML-aanmelding:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the service (default)"
msgstr "In de service (standaard)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the login dialog"
msgstr "In het aanmeldvenster"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Where the browser login runs: in the service, or in the login dialog (in your session)."
msgstr "Waar de aanmelding via de browser draait: in de service of in het aanmeldvenster (in uw sessie)."
