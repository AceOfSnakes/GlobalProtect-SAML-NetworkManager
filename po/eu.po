#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "%s:"
msgstr "%s:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Address is a gateway (skip the portal)"
msgstr "Helbidea atebide bat da (saltatu ataria)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Address of the GlobalProtect portal (e.g. vpn.company.com).\n"
"If your organisation gave you a gateway address instead, also tick \"Address is a gateway\" below."
msgstr ""
"GlobalProtect atariaren helbidea (adib. vpn.company.com).\n"
"Zure erakundeak atebide baten helbidea eman badizu, markatu behean «Helbidea atebide bat da» ere."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Always on"
msgstr "Beti aktibo"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authenticate VPN: %s"
msgstr "Autentifikatu VPNa: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authentication failed. Enter the credentials for “%s” again."
msgstr "Autentifikazioak huts egin du. Sartu berriro “%s” konexioaren kredentzialak."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Authentication:"
msgstr "Autentifikazioa:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Automatic (enable when the portal needs it)"
msgstr "Automatikoa (gaitu atariak behar duenean)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser (SAML, passkey, 2FA)"
msgstr "Nabigatzailea (SAML, passkey, 2FA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser used for SAML/2FA authentication. \"edge\" is the best tested option; \"default\" uses your desktop's default browser.\n"
"Select 'Custom...' to give the full path to your own executable."
msgstr ""
"SAML/2FA autentifikaziorako erabiltzen den nabigatzailea. «edge» da gehien probatutako aukera; «default» aukerak zure mahaigainaren nabigatzaile lehenetsia erabiltzen du.\n"
"Aukeratu 'Pertsonalizatua...' zure exekutagarriaren bide osoa emateko."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser:"
msgstr "Nabigatzailea:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser: the portal opens a browser window for single sign-on (default).\n"
"Username and password: the portal asks on the terminal - the credentials and any token are requested in a dialog instead."
msgstr ""
"Nabigatzailea: atariak nabigatzaile-leiho bat irekitzen du saio-hasiera bakarrerako (lehenetsia).\n"
"Erabiltzaile-izena eta pasahitza: atariak terminalean galdetzen du - horren ordez, kredentzialak eta token-ak elkarrizketa-koadro batean eskatzen dira."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Connect timeout:"
msgstr "Konexio-denbora-muga:"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Credentials are required to connect to “%s”."
msgstr "Kredentzialak behar dira “%s” konexiora konektatzeko."

#: plugins/gnome/nm-gpclient-editor-common.h plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Custom..."
msgstr "Pertsonalizatua..."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "DNS Servers:"
msgstr "DNS zerbitzariak:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: built-in HIP report"
msgstr "Hutsik: HIP txosten integratua"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable HIP (Host Integrity Protection) to send host information to the VPN gateway.\n"
"This is required by some organizations for security compliance."
msgstr ""
"Gaitu HIP (Host Integrity Protection) ostalariaren informazioa VPN atebidera bidaltzeko.\n"
"Erakunde batzuek segurtasun-betetzeagatik eskatzen dute."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Enable Host Integrity Protection (HIP)"
msgstr "Gaitu ostalariaren osotasun-babesa (HIP)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable when the address above is a gateway rather than a portal.\n"
"Without this the portal workflow is tried first, which can make you authenticate twice."
msgstr ""
"Gaitu goiko helbidea ataria ez baina atebidea denean.\n"
"Hau gabe, atariaren lan-fluxua probatzen da lehenengo, eta baliteke bi aldiz autentifikatu behar izatea."

#: plugins/gnome/nm-gpclient-editor-common.h
msgid "First proposed by portal (automatic)"
msgstr "Atariak lehenengo proposatutakoa (automatikoa)"

#: plugins/gnome/nm-gpclient-editor-plugin.c
#: plugins/gnome/nm-gpclient-plugin-simple.c
msgid "GlobalProtect VPN Client"
msgstr "GlobalProtect VPN bezeroa"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP script:"
msgstr "HIP script-a:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP:"
msgstr "HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"How long NetworkManager waits for the VPN to connect, including the login in the browser (vpn.timeout).\n"
"0 uses the NetworkManager default, usually 60 s - often too short for a SAML login with MFA. A new connection with browser authentication starts with 360 s. While a connection has no timeout of its own (0) and you have not changed this field, choosing browser authentication sets 360 s."
msgstr ""
"NetworkManager-ek zenbat denbora itxaroten duen VPNa konektatzeko, nabigatzailean saioa hastea barne (vpn.timeout).\n"
"0 balioak NetworkManager-en lehenetsia erabiltzen du, normalean 60 s - askotan laburregia da MFA duen SAML saio-hasierarako. Nabigatzaile bidezko autentifikazioa duen konexio berri batek 360 s-rekin hasten da. Konexioak bere denbora-mugarik ez duen bitartean (0) eta eremu hau aldatu ez duzunean, nabigatzaile bidezko autentifikazioa aukeratzeak 360 s ezartzen ditu."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Legacy TLS renegotiation:"
msgstr "TLS birnegoziazio zaharra:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "MTU:"
msgstr "MTU:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Maximum size of a packet in the tunnel.\n"
"0 = Automatic. Lowering it (for example to 1300-1400) may help when the tunnel falls back from ESP to HTTPS with \"Message too long\".\n"
"It has an effect only when the gateway sends no MTU of its own. Values from 1 to 575 are saved as 576, the lowest value that is used."
msgstr ""
"Tuneleko paketearen gehienezko tamaina.\n"
"0 = Automatikoa. Txikiagotzeak (adibidez 1300-1400ra) lagun dezake tunelak ESP-tik HTTPS-ra jotzen duenean «Message too long» errorearekin.\n"
"Atebideak bere MTUrik bidaltzen ez duenean bakarrik du eragina. 1etik 575era bitarteko balioak 576 gisa gordetzen dira, erabiltzen den balio txikiena."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Never"
msgstr "Inoiz ez"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to a custom HIP executable, passed to gpclient as --hip=<path>.\n"
"The service runs it as root: it must be a root-owned file that is not writable by group or others, in root-owned directories that are not writable by group or others. Otherwise the connection fails.\n"
"Ignored when HIP is off."
msgstr ""
"Aukerakoa. HIP exekutagarri pertsonalizatu baterako bide absolutua, gpclient-i --hip=<path> gisa pasatua.\n"
"Zerbitzuak root gisa exekutatzen du: root-en jabetzako fitxategi bat izan behar da, taldeak edo besteek idatz ezin dutena, root-en jabetzako direktorioetan, taldeak edo besteek idatz ezin dituztenetan. Bestela, konexioak huts egiten du.\n"
"HIP desaktibatuta dagoenean ez da kontuan hartzen."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Use the icon in the field to choose where the password is kept: for this user only, for all users, or not at all (asked every time)."
msgstr "Aukerakoa. Erabili eremuko ikonoa pasahitza non gordetzen den aukeratzeko: erabiltzaile honentzat soilik, erabiltzaile guztientzat edo batere ez (aldi bakoitzean galdetzen da)."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Used by portals that ask for credentials on the terminal, so you are not asked for the username every time."
msgstr "Aukerakoa. Terminalean kredentzialak eskatzen dituzten atariek erabiltzen dute, erabiltzaile-izena aldi bakoitzean galdetu ez diezazuten."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Password"
msgstr "Pasahitza"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Password:"
msgstr "Pasahitza:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Portal or gateway address:"
msgstr "Atariaren edo atebidearen helbidea:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Portals with an old TLS stack need renegotiation that OpenSSL 3 refuses by default.\n"
"Automatic: retry once with the workaround when the portal asks for it, and switch this setting to \"Always on\" afterwards, so the failed first attempt does not repeat."
msgstr ""
"TLS pila zaharra duten atariek OpenSSL 3-k lehenespenez baztertzen duen birnegoziazioa behar dute.\n"
"Automatikoa: saiatu berriro behin soluzioarekin atariak eskatzen duenean, eta ondoren ezarpen hau «Beti aktibo» aukerara aldatu, huts egindako lehen saiakera errepikatu ez dadin."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Preferred gateway:"
msgstr "Atebide hobetsia:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Recommended: Leave empty to use DNS servers from VPN with automatic split DNS configuration.\n"
"Split DNS allows resolving VPN-specific domains through VPN DNS while using local DNS for other domains.\n"
"Override: Enter semicolon-separated DNS servers (e.g., 8.8.8.8;8.8.4.4) to use custom DNS instead."
msgstr ""
"Gomendatua: utzi hutsik VPNko DNS zerbitzariak split DNS konfigurazio automatikoarekin erabiltzeko.\n"
"Split DNS-ak VPNko domeinuak VPNko DNS bidez ebaztea ahalbidetzen du, beste domeinuetarako DNS lokala erabiliz.\n"
"Gainidatzi: sartu puntu eta komaz bereizitako DNS zerbitzariak (adib. 8.8.8.8;8.8.4.4) DNS pertsonalizatua erabiltzeko."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Token / one-time code"
msgstr "Token-a / aldi bakarreko kodea"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "User: %s"
msgstr "Erabiltzailea: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Username"
msgstr "Erabiltzaile-izena"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username and password (RSA token)"
msgstr "Erabiltzaile-izena eta pasahitza (RSA tokena)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username:"
msgstr "Erabiltzaile-izena:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Which gateway to connect to. The list is filled in after the first successful connection.\n"
"If the chosen gateway is not offered by the portal any more, the first proposal is used instead."
msgstr ""
"Zein atebidetara konektatu. Zerrenda lehen konexio arrakastatsuaren ondoren betetzen da.\n"
"Aukeratutako atebidea atariak jada eskaintzen ez badu, lehen proposamena erabiltzen da."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_Cancel"
msgstr "_Utzi"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_OK"
msgstr "_Ados"

#: plugins/gnome/nm-gpclient-validate.h
msgid "browser must be a name, a command name or an absolute path without spaces"
msgstr "nabigatzailea izen bat, komando-izen bat edo zuriunerik gabeko bide absolutu bat izan behar da"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "bytes (0 = Automatic)"
msgstr "byte (0 = Automatikoa)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "dns must be IPv4 or IPv6 addresses separated by commas, semicolons or spaces"
msgstr "dns-ak IPv4 edo IPv6 helbideak izan behar dira, komaz, puntu eta komaz edo zuriunez bereiziak"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway is required"
msgstr "atebidea beharrezkoa da"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway must not start with '-' or contain spaces or control characters"
msgstr "atebideak ez du '-'-rekin hasi behar, ez eta zuriunerik edo kontrol-karakterik izan"

#: plugins/gnome/nm-gpclient-validate.h
msgid "hip-script must be an absolute path"
msgstr "hip-script bide absolutu bat izan behar da"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "seconds (0 = NetworkManager default)"
msgstr "segundo (0 = NetworkManager-en lehenetsia)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "username must not start with '-' or contain control characters"
msgstr "erabiltzaile-izenak ez du '-'-rekin hasi behar, ez eta kontrol-karakterik izan"

#: plugins/gnome/nm-gpclient-keyfile.h
msgid "The file is not a GlobalProtect VPN connection"
msgstr "Fitxategia ez da GlobalProtect VPN konexio bat"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "SAML login:"
msgstr "SAML saio-hasiera:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the service (default)"
msgstr "Zerbitzuan (lehenetsia)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the login dialog"
msgstr "Saio-hasierako elkarrizketa-koadroan"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Where the browser login runs: in the service, or in the login dialog (in your session)."
msgstr "Nabigatzailearekin saioa non hasten den: zerbitzuan edo saio-hasierako elkarrizketa-koadroan (zure saioan)."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Certificate passphrase"
msgstr "Ziurtagiriaren pasaesaldia"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Certificate passphrase:"
msgstr "Ziurtagiriaren pasaesaldia:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Client certificate:"
msgstr "Bezero-ziurtagiria:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: no client certificate"
msgstr "Hutsik: bezero-ziurtagiririk ez"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: the key is in the certificate file"
msgstr "Hutsik: gakoa ziurtagiri-fitxategian dago"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the client certificate file (PEM or PKCS#12), "
"owned by your desktop user."
msgstr "Bezero-ziurtagiriaren fitxategiaren bide-izen absolutu aukerakoa (PEM edo PKCS#12), mahaigaineko erabiltzailearen jabetzakoa izan behar duena."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the private key file (PEM), owned by your "
"desktop user. Ignored without a client certificate."
msgstr "Gako pribatuaren fitxategiaren bide-izen absolutu aukerakoa (PEM), mahaigaineko erabiltzailearen jabetzakoa izan behar duena. Ez da kontuan hartzen bezero-ziurtagiririk gabe."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Private key:"
msgstr "Gako pribatua:"

#: plugins/gnome/nm-gpclient-validate.h
msgid "usercert must be an absolute path"
msgstr "usercert bide absolutu bat izan behar da"

#: plugins/gnome/nm-gpclient-validate.h
msgid "userkey must be an absolute path"
msgstr "userkey bide absolutu bat izan behar da"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose a file"
msgstr "Aukeratu fitxategi bat"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the client certificate"
msgstr "Aukeratu bezero-ziurtagiria"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the private key"
msgstr "Aukeratu gako pribatua"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the HIP script"
msgstr "Aukeratu HIP script-a"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Let NetworkManager set the routes and DNS (experimental)"
msgstr "Utzi NetworkManager-i bideak eta DNS ezartzen (esperimentala)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "NetworkManager configures the tunnel's routes, DNS and default route from what the gateway sends, instead of vpnc-script. Routes the gateway excludes from the tunnel are ignored."
msgstr "NetworkManager-ek tunelaren bideak, DNS eta lehenetsitako bidea konfiguratzen ditu atebideak bidaltzen duenaren arabera, vpnc-script-en ordez. Atebideak tunelatik kanpo uzten dituen bideak alde batera uzten dira."
