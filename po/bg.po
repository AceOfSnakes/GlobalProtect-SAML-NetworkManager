#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "%s:"
msgstr "%s:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Address is a gateway (skip the portal)"
msgstr "Адресът е шлюз (пропускане на портала)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Address of the GlobalProtect portal (e.g. vpn.company.com).\n"
"If your organisation gave you a gateway address instead, also tick \"Address is a gateway\" below."
msgstr ""
"Адрес на портала на GlobalProtect (напр. vpn.company.com).\n"
"Ако организацията ви е дала адрес на шлюз, отбележете и „Адресът е шлюз“ по-долу."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Always on"
msgstr "Винаги включено"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authenticate VPN: %s"
msgstr "Удостоверяване на VPN: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Authentication failed. Enter the credentials for “%s” again."
msgstr "Удостоверяването е неуспешно. Въведете отново данните за вход за „%s“."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Authentication:"
msgstr "Удостоверяване:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Automatic (enable when the portal needs it)"
msgstr "Автоматично (включване, когато порталът го изисква)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser (SAML, passkey, 2FA)"
msgstr "Браузър (SAML, passkey, 2FA)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser used for SAML/2FA authentication. \"edge\" is the best tested option; \"default\" uses your desktop's default browser.\n"
"Select 'Custom...' to give the full path to your own executable."
msgstr ""
"Браузър за удостоверяване чрез SAML/2FA. „edge“ е най-добре тестваният вариант; „default“ използва стандартния браузър на работния плот.\n"
"Изберете „Друг...“, за да зададете пълния път до собствена изпълнима програма."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Browser:"
msgstr "Браузър:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Browser: the portal opens a browser window for single sign-on (default).\n"
"Username and password: the portal asks on the terminal - the credentials and any token are requested in a dialog instead."
msgstr ""
"Браузър: порталът отваря прозорец на браузъра за единен вход (по подразбиране).\n"
"Потребителско име и парола: порталът пита в терминала – вместо това данните за вход и евентуалният токен се искат в диалогов прозорец."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Connect timeout:"
msgstr "Време за изчакване на връзката:"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "Credentials are required to connect to “%s”."
msgstr "Необходими са данни за вход, за да се свържете с „%s“."

#: plugins/gnome/nm-gpclient-editor-common.h plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Custom..."
msgstr "Друг..."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "DNS Servers:"
msgstr "DNS сървъри:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: built-in HIP report"
msgstr "Празно: вграден HIP отчет"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable HIP (Host Integrity Protection) to send host information to the VPN gateway.\n"
"This is required by some organizations for security compliance."
msgstr ""
"Включете HIP (Host Integrity Protection), за да се изпраща информация за хоста към VPN шлюза.\n"
"Някои организации го изискват за съответствие със сигурността."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Enable Host Integrity Protection (HIP)"
msgstr "Включване на Host Integrity Protection (HIP)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Enable when the address above is a gateway rather than a portal.\n"
"Without this the portal workflow is tried first, which can make you authenticate twice."
msgstr ""
"Включете, когато адресът по-горе е шлюз, а не портал.\n"
"Без това първо се опитва работният процес на портала, което може да ви накара да се удостоверите два пъти."

#: plugins/gnome/nm-gpclient-editor-common.h
msgid "First proposed by portal (automatic)"
msgstr "Първият предложен от портала (автоматично)"

#: plugins/gnome/nm-gpclient-editor-plugin.c
#: plugins/gnome/nm-gpclient-plugin-simple.c
msgid "GlobalProtect VPN Client"
msgstr "VPN клиент GlobalProtect"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP script:"
msgstr "HIP скрипт:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "HIP:"
msgstr "HIP:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"How long NetworkManager waits for the VPN to connect, including the login in the browser (vpn.timeout).\n"
"0 uses the NetworkManager default, usually 60 s - often too short for a SAML login with MFA. A new connection with browser authentication starts with 360 s. While a connection has no timeout of its own (0) and you have not changed this field, choosing browser authentication sets 360 s."
msgstr ""
"Колко дълго NetworkManager чака VPN да се свърже, включително влизането в браузъра (vpn.timeout).\n"
"0 използва стандартната стойност на NetworkManager, обикновено 60 s – често твърде кратка за SAML вход с MFA. Нова връзка с удостоверяване чрез браузър започва с 360 s. Докато връзката няма собствено време за изчакване (0) и не сте променили това поле, изборът на удостоверяване чрез браузър задава 360 s."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Legacy TLS renegotiation:"
msgstr "Остаряло повторно договаряне на TLS:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "MTU:"
msgstr "MTU:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Maximum size of a packet in the tunnel.\n"
"0 = Automatic. Lowering it (for example to 1300-1400) may help when the tunnel falls back from ESP to HTTPS with \"Message too long\".\n"
"It has an effect only when the gateway sends no MTU of its own. Values from 1 to 575 are saved as 576, the lowest value that is used."
msgstr ""
"Максимален размер на пакет в тунела.\n"
"0 = Автоматично. Намаляването му (например до 1300-1400) може да помогне, когато тунелът преминава от ESP към HTTPS със „Message too long“.\n"
"Има ефект само когато шлюзът не изпраща собствено MTU. Стойностите от 1 до 575 се запазват като 576, най-ниската използвана стойност."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Never"
msgstr "Никога"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to a custom HIP executable, passed to gpclient as --hip=<path>.\n"
"The service runs it as root: it must be a root-owned file that is not writable by group or others, in root-owned directories that are not writable by group or others. Otherwise the connection fails.\n"
"Ignored when HIP is off."
msgstr ""
"Незадължителен абсолютен път до собствена HIP програма, която се подава на gpclient като --hip=<path>.\n"
"Услугата я стартира като root: трябва да е файл, притежаван от root, в който групата и останалите не могат да пишат, в директории, притежавани от root, в които групата и останалите не могат да пишат. Иначе връзката се проваля.\n"
"Игнорира се, когато HIP е изключено."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Use the icon in the field to choose where the password is kept: for this user only, for all users, or not at all (asked every time)."
msgstr "Незадължително. Използвайте иконата в полето, за да изберете къде се пази паролата: само за този потребител, за всички потребители или никъде (пита се всеки път)."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Optional. Used by portals that ask for credentials on the terminal, so you are not asked for the username every time."
msgstr "Незадължително. Използва се от портали, които искат данни за вход в терминала, за да не ви питат за потребителското име всеки път."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Password"
msgstr "Парола"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Password:"
msgstr "Парола:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Portal or gateway address:"
msgstr "Адрес на портал или шлюз:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Portals with an old TLS stack need renegotiation that OpenSSL 3 refuses by default.\n"
"Automatic: retry once with the workaround when the portal asks for it, and switch this setting to \"Always on\" afterwards, so the failed first attempt does not repeat."
msgstr ""
"Портали със стар TLS стек изискват повторно договаряне, което OpenSSL 3 отказва по подразбиране.\n"
"Автоматично: опитва се още веднъж с решението, когато порталът го поиска, и след това превключва тази настройка на „Винаги включено“, така че неуспешният първи опит да не се повтаря."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Preferred gateway:"
msgstr "Предпочитан шлюз:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Recommended: Leave empty to use DNS servers from VPN with automatic split DNS configuration.\n"
"Split DNS allows resolving VPN-specific domains through VPN DNS while using local DNS for other domains.\n"
"Override: Enter semicolon-separated DNS servers (e.g., 8.8.8.8;8.8.4.4) to use custom DNS instead."
msgstr ""
"Препоръчително: оставете празно, за да се ползват DNS сървърите от VPN с автоматична конфигурация на split DNS.\n"
"Split DNS позволява разрешаването на специфични за VPN домейни през DNS на VPN, докато за останалите домейни се ползва локалният DNS.\n"
"Замяна: въведете DNS сървъри, разделени с точка и запетая (напр. 8.8.8.8;8.8.4.4), за да се ползват собствени DNS сървъри."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Token / one-time code"
msgstr "Токен / еднократен код"

#: auth-dialog/nm-gpclient-auth-dialog.py
#, python-format
msgid "User: %s"
msgstr "Потребител: %s"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Username"
msgstr "Потребителско име"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username and password (RSA token)"
msgstr "Потребителско име и парола (RSA токен)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Username:"
msgstr "Потребителско име:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Which gateway to connect to. The list is filled in after the first successful connection.\n"
"If the chosen gateway is not offered by the portal any more, the first proposal is used instead."
msgstr ""
"С кой шлюз да се свърже. Списъкът се попълва след първата успешна връзка.\n"
"Ако избраният шлюз вече не се предлага от портала, вместо това се използва първото предложение."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_Cancel"
msgstr "_Отказ"

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "_OK"
msgstr "_Добре"

#: plugins/gnome/nm-gpclient-validate.h
msgid "browser must be a name, a command name or an absolute path without spaces"
msgstr "browser трябва да е име, име на команда или абсолютен път без интервали"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "bytes (0 = Automatic)"
msgstr "байта (0 = автоматично)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "dns must be IPv4 or IPv6 addresses separated by commas, semicolons or spaces"
msgstr "dns трябва да са IPv4 или IPv6 адреси, разделени със запетаи, точки и запетаи или интервали"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway is required"
msgstr "gateway е задължително"

#: plugins/gnome/nm-gpclient-validate.h
msgid "gateway must not start with '-' or contain spaces or control characters"
msgstr "gateway не трябва да започва с „-“ или да съдържа интервали или управляващи знаци"

#: plugins/gnome/nm-gpclient-validate.h
msgid "hip-script must be an absolute path"
msgstr "hip-script трябва да е абсолютен път"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "seconds (0 = NetworkManager default)"
msgstr "секунди (0 = стандартната стойност на NetworkManager)"

#: plugins/gnome/nm-gpclient-validate.h
msgid "username must not start with '-' or contain control characters"
msgstr "username не трябва да започва с „-“ или да съдържа управляващи знаци"

#: plugins/gnome/nm-gpclient-keyfile.h
msgid "The file is not a GlobalProtect VPN connection"
msgstr "Файлът не е връзка GlobalProtect VPN"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "SAML login:"
msgstr "SAML вход:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the service (default)"
msgstr "В услугата (по подразбиране)"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "In the login dialog"
msgstr "В диалога за вход"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Where the browser login runs: in the service, or in the login dialog (in your session)."
msgstr "Къде се изпълнява входът през браузър: в услугата или в диалога за вход (във вашата сесия)."

#: auth-dialog/nm-gpclient-auth-dialog.py
msgid "Certificate passphrase"
msgstr "Парола на сертификата"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Certificate passphrase:"
msgstr "Парола на сертификата:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Client certificate:"
msgstr "Клиентски сертификат:"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: no client certificate"
msgstr "Празно: без клиентски сертификат"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Empty: the key is in the certificate file"
msgstr "Празно: ключът е във файла на сертификата"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the client certificate file (PEM or PKCS#12), "
"owned by your desktop user."
msgstr "Незадължителен абсолютен път до файла на клиентския сертификат (PEM или PKCS#12), собственост на потребителя на работния плот."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid ""
"Optional absolute path to the private key file (PEM), owned by your "
"desktop user. Ignored without a client certificate."
msgstr "Незадължителен абсолютен път до файла на частния ключ (PEM), собственост на потребителя на работния плот. Игнорира се без клиентски сертификат."

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Private key:"
msgstr "Частен ключ:"

#: plugins/gnome/nm-gpclient-validate.h
msgid "usercert must be an absolute path"
msgstr "usercert трябва да е абсолютен път"

#: plugins/gnome/nm-gpclient-validate.h
msgid "userkey must be an absolute path"
msgstr "userkey трябва да е абсолютен път"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose a file"
msgstr "Избор на файл"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the client certificate"
msgstr "Избор на клиентския сертификат"

#: plugins/gnome/nm-gpclient-editor-gtk3.c plugins/gnome/nm-gpclient-editor.c
msgid "Choose the private key"
msgstr "Избор на личния ключ"
