#!/bin/bash
# Debug wrapper for vpnc-script: logs the tunnel settings and the trace of the
# real script to the journal (tag vpnc-script-debug), then runs the real script
# and exits with its status. Manual opt-in, the package does not install it.
# VPNC_SCRIPT_REAL: the real script (default /usr/share/vpnc-scripts/vpnc-script
# on Debian/Ubuntu, /etc/vpnc/vpnc-script on Fedora, EL and openSUSE)

# VPNC_SCRIPT_DEBUG_ROOT: prefix of the default paths, for the tests only
real=$VPNC_SCRIPT_REAL
if [ -z "$real" ]; then
    real=${VPNC_SCRIPT_DEBUG_ROOT:-}/usr/share/vpnc-scripts/vpnc-script
    [ -e "$real" ] || real=${VPNC_SCRIPT_DEBUG_ROOT:-}/etc/vpnc/vpnc-script
fi
tag=vpnc-script-debug

if [ ! -x "$real" ]; then
    echo "vpnc-script-debug: the real script $real is missing or not executable" >&2
    logger -t "$tag" "the real script $real is missing or not executable"
    exit 1
fi

# Only the variables that describe the tunnel, not the whole environment
env | grep -E '^(reason|TUNDEV|VPNGATEWAY|INTERNAL_IP4_[A-Z0-9_]*|INTERNAL_IP6_[A-Z0-9_]*|CISCO_SPLIT_[A-Z0-9_]*|CISCO_IPV6_SPLIT_[A-Z0-9_]*|MTU|CISCO_DEF_DOMAIN)=' |
    sort | logger -t "$tag"

# The real script is POSIX sh (dash on Ubuntu): trace it with the same shell
sh -x "$real" "$@" 2>&1 | logger -t "$tag"
exit "${PIPESTATUS[0]}"
