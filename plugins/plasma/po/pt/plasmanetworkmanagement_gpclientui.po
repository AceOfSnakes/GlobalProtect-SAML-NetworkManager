#, kde-format
msgid "Certificate passphrase"
msgstr "Frase-passe do certificado"

#: rc.cpp
#, kde-format
msgid "Certificate passphrase:"
msgstr "Frase-passe do certificado:"

#: rc.cpp
#, kde-format
msgid "Client certificate:"
msgstr "Certificado de cliente:"

#: rc.cpp
#, kde-format
