#, kde-format
msgid "usercert must be an absolute path"
msgstr "usercert trebuie să fie o cale absolută"

#: gpclientui.cpp
#, kde-format
msgid "userkey must be an absolute path"
msgstr "userkey trebuie să fie o cale absolută"

