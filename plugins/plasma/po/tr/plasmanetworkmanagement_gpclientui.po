msgstr "ağ geçidi '-' ile başlamamalı, boşluk veya denetim karakteri içermemelidir"

#: gpclientui.cpp
#, kde-format
msgid "username must not start with '-' or contain control characters"
msgstr "kullanıcı adı '-' ile başlamamalı veya denetim karakteri içermemelidir"

#: gpclientui.cpp
#, kde-format
msgid "browser must be a name, a command name or an absolute path without spaces"
msgstr "tarayıcı bir ad, bir komut adı veya boşluksuz mutlak bir yol olmalıdır"

