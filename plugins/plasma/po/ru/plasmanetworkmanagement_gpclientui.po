#: rc.cpp
#, kde-format
msgid " bytes"
msgstr " байт"

#: rc.cpp
#, kde-format
msgid " s"
msgstr " с"

#: rc.cpp
#, kde-format
msgid "Address is a gateway (skip the portal)"
msgstr "Адрес является шлюзом (пропустить портал)"

#: rc.cpp
#, kde-format
msgid ""
"Address of the GlobalProtect portal (e.g. vpn.company.com).\n"
"If your organisation gave you a gateway address instead, also tick \"Address "
"is a gateway\" below."
msgstr ""
"Адрес портала GlobalProtect (например, vpn.company.com).\n"
"Если ваша организация выдала вам вместо этого адрес шлюза, также отметьте «Адрес является шлюзом» ниже."

#: gpclientwidget.cpp
#, kde-format
msgid "Always on"
msgstr "Всегда включено"

#: gpclientwidget.cpp
#, kde-format
msgid "Ask every time (not saved)"
msgstr "Спрашивать каждый раз (не сохраняется)"

#: rc.cpp
#, kde-format
msgid "Authentication:"
msgstr "Аутентификация:"

#: rc.cpp
#, kde-format
msgid "Automatic"
msgstr "Автоматически"

#: gpclientwidget.cpp
#, kde-format
msgid "Automatic (enable when the portal needs it)"
msgstr "Автоматически (включать, когда это нужно порталу)"

#: gpclientwidget.cpp
#, kde-format
msgid "Browser (SAML, passkey, 2FA)"
msgstr "Браузер (SAML, passkey, 2FA)"

#: rc.cpp
#, kde-format
msgid ""
"Browser used for SAML/2FA authentication. \"edge\" is the best tested "
"option; \"default\" uses your desktop's default browser.\n"
"Select 'Custom...' to give the full path to your own executable."
msgstr ""
"Браузер для аутентификации SAML/2FA. «edge» — наиболее проверенный вариант; «default» использует браузер по умолчанию на вашем рабочем столе.\n"
"Выберите «Другой...», чтобы указать полный путь к своему исполняемому файлу."

#: rc.cpp
#, kde-format
msgid "Browser:"
msgstr "Браузер:"

#: rc.cpp
#, kde-format
msgid ""
"Browser: the portal opens a browser window for single sign-on (default).\n"
"Username and password: the portal asks on the terminal - the credentials and "
"any token are requested in a dialog instead."
msgstr ""
"Браузер: портал открывает окно браузера для единого входа (по умолчанию).\n"
"Имя пользователя и пароль: портал запрашивает данные в терминале — вместо этого учётные данные и токен запрашиваются в диалоговом окне."

#: rc.cpp
#, kde-format
msgid "Connect timeout:"
msgstr "Тайм-аут подключения:"

#: gpclientwidget.cpp
#, kde-format
msgid "Custom..."
msgstr "Другой..."

#: rc.cpp
#, kde-format
msgid "DNS Servers:"
msgstr "DNS-серверы:"

#: rc.cpp
#, kde-format
msgid "Empty: built-in HIP report"
msgstr "Пусто: встроенный отчёт HIP"

#: rc.cpp
#, kde-format
msgid ""
"Enable HIP (Host Integrity Protection) to send host information to the VPN "
"gateway. This is required by some organizations for security compliance."
msgstr "Включите HIP (Host Integrity Protection), чтобы отправлять сведения об узле на шлюз VPN. Это требуется некоторым организациям для соблюдения требований безопасности."

#: rc.cpp
#, kde-format
msgid "Enable Host Integrity Protection (HIP)"
msgstr "Включить Host Integrity Protection (HIP)"

#: rc.cpp
#, kde-format
msgid ""
"Enable when the address above is a gateway rather than a portal.\n"
"Without this the portal workflow is tried first, which can make you "
"authenticate twice."
msgstr ""
"Включите, если указанный выше адрес — это шлюз, а не портал.\n"
"Без этого сначала выполняется процедура портала, из-за чего аутентификацию, возможно, придётся пройти дважды."

#: gpclientwidget.cpp
#, kde-format
msgid "First proposed by portal (automatic)"
msgstr "Первый, предложенный порталом (автоматически)"

#: rc.cpp
#, kde-format
msgid "GlobalProtect VPN"
msgstr "GlobalProtect VPN"

#: rc.cpp
#, kde-format
msgid "HIP script:"
msgstr "Сценарий HIP:"

#: rc.cpp
#, kde-format
msgid "HIP:"
msgstr "HIP:"

#: rc.cpp
#, kde-format
msgid ""
"How long NetworkManager waits for the VPN to connect, including the login in "
"the browser (vpn.timeout).\n"
"0 uses the NetworkManager default, usually 60 s - often too short for a SAML "
"login with MFA. A new connection with browser authentication starts with 360 "
"s. While a connection has no timeout of its own (0) and you have not changed "
"this field, choosing browser authentication sets 360 s."
msgstr ""
"Как долго NetworkManager ждёт подключения VPN, включая вход в браузере (vpn.timeout).\n"
"0 — значение NetworkManager по умолчанию, обычно 60 с; для входа SAML с MFA этого часто мало. Новое подключение с аутентификацией через браузер начинается с 360 с. Пока у подключения нет собственного тайм-аута (0) и вы не изменяли это поле, выбор аутентификации через браузер устанавливает 360 с."

#: rc.cpp
#, kde-format
msgid "Leave empty for automatic VPN DNS (recommended)"
msgstr "Оставьте пустым для автоматического DNS VPN (рекомендуется)"

#: rc.cpp
#, kde-format
msgid "Legacy TLS renegotiation:"
msgstr "Устаревший повторный обмен TLS:"

#: rc.cpp
#, kde-format
msgid "MTU:"
msgstr "MTU:"

#: rc.cpp
#, kde-format
msgid ""
"Maximum size of a packet in the tunnel.\n"
"Automatic (0): openconnect picks the value. Lowering it (for example to "
"1300-1400) may help when the tunnel falls back from ESP to HTTPS with "
"\"Message too long\".\n"
"It has an effect only when the gateway sends no MTU of its own. Values from "
"1 to 575 are saved as 576, the lowest value that is used."
msgstr ""
"Максимальный размер пакета в туннеле.\n"
"Автоматически (0): значение выбирает openconnect. Уменьшение значения (например, до 1300-1400) может помочь, если туннель переключается с ESP на HTTPS с ошибкой «Message too long».\n"
"Действует только если шлюз не присылает собственный MTU. Значения от 1 до 575 сохраняются как 576 — наименьшее используемое значение."

#: rc.cpp
#, kde-format
msgid "NetworkManager default (usually 60 s)"
msgstr "Значение NetworkManager по умолчанию (обычно 60 с)"

#: gpclientwidget.cpp
#, kde-format
msgid "Never"
msgstr "Никогда"

#: rc.cpp
#, kde-format
msgid "Optional"
msgstr "Необязательно"

#: rc.cpp
#, kde-format
msgid ""
"Optional absolute path to a custom HIP executable, passed to gpclient as --"
"hip=<path>.\n"
"The service runs it as root: it must be a root-owned file that is not "
"writable by group or others, in root-owned directories that are not writable "
"by group or others. Otherwise the connection fails.\n"
"Ignored when HIP is off."
msgstr ""
"Необязательный абсолютный путь к собственному исполняемому файлу HIP, передаваемый gpclient как --hip=<path>.\n"
"Служба запускает его от имени root: файл должен принадлежать root и быть недоступным для записи группе и остальным, в каталогах, принадлежащих root и недоступных для записи группе и остальным. Иначе подключение завершится ошибкой.\n"
"Игнорируется, если HIP выключен."

#: rc.cpp
#, kde-format
msgid ""
"Optional. Used by portals that ask for credentials on the terminal, so you "
"are not asked for the username every time."
msgstr "Необязательно. Используется порталами, которые запрашивают учётные данные в терминале, чтобы имя пользователя не запрашивалось каждый раз."

#: rc.cpp
#, kde-format
msgid "Optional. Used by the \"Username and password\" authentication."
msgstr "Необязательно. Используется при аутентификации «Имя пользователя и пароль»."

#: gpclientauthwidget.cpp
#, kde-format
msgid "Password"
msgstr "Пароль"

#: rc.cpp
#, kde-format
msgid "Password storage:"
msgstr "Хранение пароля:"

#: rc.cpp
#, kde-format
msgid "Password:"
msgstr "Пароль:"

#: rc.cpp
#, kde-format
msgid "Portal or gateway address:"
msgstr "Адрес портала или шлюза:"

#: rc.cpp
#, kde-format
msgid ""
"Portals with an old TLS stack need renegotiation that OpenSSL 3 refuses by "
"default.\n"
"Automatic: retry once with the workaround when the portal asks for it, and "
"switch this setting to \"Always on\" afterwards, so the failed first attempt "
"does not repeat."
msgstr ""
"Порталам со старым стеком TLS требуется повторный обмен, который OpenSSL 3 по умолчанию отклоняет.\n"
"Автоматически: повторить попытку один раз с обходным решением, когда это требует портал, и затем переключить этот параметр на «Всегда включено», чтобы неудачная первая попытка не повторялась."

#: rc.cpp
#, kde-format
msgid "Preferred gateway:"
msgstr "Предпочитаемый шлюз:"

#: rc.cpp
#, kde-format
msgid ""
"Recommended: Leave empty to use DNS servers from VPN with automatic split "
"DNS configuration.\n"
"Split DNS allows resolving VPN-specific domains through VPN DNS while using "
"local DNS for other domains.\n"
"Override: Enter semicolon-separated DNS servers (e.g., 8.8.8.8;8.8.4.4) to "
"use custom DNS instead."
msgstr ""
"Рекомендуется: оставьте пустым, чтобы использовать DNS-серверы VPN с автоматической раздельной настройкой DNS.\n"
"Раздельный DNS позволяет разрешать домены VPN через DNS VPN, а остальные домены — через локальный DNS.\n"
"Переопределение: введите DNS-серверы через точку с запятой (например, 8.8.8.8;8.8.4.4), чтобы использовать вместо этого свои."

#: gpclientwidget.cpp
#, kde-format
msgid "Store for all users (system)"
msgstr "Хранить для всех пользователей (системно)"

#: gpclientwidget.cpp
#, kde-format
msgid "Store for this user only (agent)"
msgstr "Хранить только для этого пользователя (агент)"

#: gpclientauthwidget.cpp
#, kde-format
msgid "Token / one-time code"
msgstr "Токен / одноразовый код"

#: gpclientauthwidget.cpp
#, kde-format
msgid "Username"
msgstr "Имя пользователя"

#: gpclientwidget.cpp
#, kde-format
msgid "Username and password (RSA token)"
msgstr "Имя пользователя и пароль (токен RSA)"

#: rc.cpp
#, kde-format
msgid "Username:"
msgstr "Имя пользователя:"

#: rc.cpp
#, kde-format
msgid "Where the password is kept. \"Ask every time\" stores nothing."
msgstr "Где хранится пароль. «Спрашивать каждый раз» ничего не сохраняет."

#: rc.cpp
#, kde-format
msgid ""
"Which gateway to connect to. The list is filled in after the first "
"successful connection.\n"
"If the chosen gateway is not offered by the portal any more, the first "
"proposal is used instead."
msgstr ""
"К какому шлюзу подключаться. Список заполняется после первого успешного подключения.\n"
"Если выбранный шлюз больше не предлагается порталом, вместо него используется первое предложение."

#: rc.cpp
#, kde-format
msgid "vpn.company.com"
msgstr "vpn.company.com"

#: gpclientui.cpp
#, kde-format
msgid "Cannot export the connection: %1"
msgstr "Не удалось экспортировать подключение: %1"

#: gpclientui.cpp
#, kde-format
msgid "Cannot import the connection: %1"
msgstr "Не удалось импортировать подключение: %1"

#: gpclientui.cpp
#, kde-format
msgid "The connection \"%1\" is not saved in NetworkManager"
msgstr "Подключение \"%1\" не сохранено в NetworkManager"

#: gpclientui.cpp
#, kde-format
msgid "The file is not a GlobalProtect VPN connection"
msgstr "Файл не является VPN-подключением GlobalProtect"

#: gpclientui.cpp
#, kde-format
msgid "gateway is required"
msgstr "требуется шлюз"

#: gpclientui.cpp
#, kde-format
msgid "gateway must not start with '-' or contain spaces or control characters"
msgstr "шлюз не должен начинаться с «-» или содержать пробелы и управляющие символы"

#: gpclientui.cpp
#, kde-format
msgid "username must not start with '-' or contain control characters"
msgstr "имя пользователя не должно начинаться с «-» или содержать управляющие символы"

#: gpclientui.cpp
#, kde-format
msgid "browser must be a name, a command name or an absolute path without spaces"
msgstr "браузер должен быть именем, именем команды или абсолютным путём без пробелов"

#: gpclientui.cpp
#, kde-format
msgid "dns must be IPv4 or IPv6 addresses separated by commas, semicolons or spaces"
msgstr "dns должен содержать адреса IPv4 или IPv6, разделённые запятыми, точками с запятой или пробелами"

#: gpclientui.cpp
#, kde-format
msgid "hip-script must be an absolute path"
msgstr "hip-script должен быть абсолютным путём"

#: rc.cpp
#, kde-format
msgid "SAML login:"
msgstr "Вход SAML:"

#: gpclientwidget.cpp
#, kde-format
msgid "In the service (default)"
msgstr "В службе (по умолчанию)"

#: gpclientwidget.cpp
#, kde-format
msgid "In the login dialog"
msgstr "В диалоге входа"

#: rc.cpp
#, kde-format
msgid "Where the browser login runs: in the service, or in the login dialog (in your session)."
msgstr "Где выполняется вход через браузер: в службе или в диалоге входа (в вашем сеансе)."

#: gpclientauthwidget.cpp
#, kde-format
msgid "Signing in…"
msgstr "Выполняется вход…"
